{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "one-bit-bureau-installer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bureau.regionallyfamous.com",
      "custom_domain": true
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sh"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
