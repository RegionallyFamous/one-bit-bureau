#!/bin/bash

set -euo pipefail

PLUGIN_ID="io.github.regionallyfamous.one-bit-bureau"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
SECURE_IO="$PLUGIN_DIR/scripts/one_bit_bureau_secure_io.py"

usage() {
  cat <<'EOF'
Usage: one-bit-bureau <command> [arguments]

Commands:
  status                       Show installed component state
  doctor [--repair app-chrome-off]
                               Diagnose installation state without writing by default
  app-chrome <preview|on|off|status>
                               Opt into or reverse the GTK3-only app-chrome preview
  update [--yes]               Update One-Bit Bureau's plugin and matching theme
  remove                       Remove owned components and restore prior settings
  overview                     Toggle the window overview
  dock <command> [arguments]   Call the One-Bit Bureau dock IPC interface
  motion <reduce|full|status>  Control motion across One-Bit Bureau surfaces
  icon <command> [arguments]   Manage automatic, pack, native, and custom app icons
  font list                    List the two bundled font choices
  font use <krypton|departure> Select a bundled font through Omarchy
EOF
}

require_install() {
  if [[ -f $PLUGIN_DIR/manifest.json && ! -L $PLUGIN_DIR/manifest.json && -f $SECURE_IO && ! -L $SECURE_IO ]] &&
    python3 "$SECURE_IO" install-state exists >/dev/null 2>&1; then
    return 0
  else
    echo "one-bit-bureau: One-Bit Bureau is not fully installed" >&2
    exit 1
  fi
}

command_name="${1:-}"
case "$command_name" in
  -h | --help | help | "")
    usage
    ;;
  status)
    require_install
    python3 "$SECURE_IO" install-state read | jq '{product, pluginId, theme, installed, previous}'
    ;;
  doctor)
    shift
    exec bash "$PLUGIN_DIR/scripts/one-bit-bureau-doctor" "$@"
    ;;
  app-chrome)
    require_install
    shift
    case "${1:-}" in
      preview | on | off | status)
        (( $# == 1 )) || { usage >&2; exit 2; }
        command -v python3 >/dev/null || { echo "one-bit-bureau: Python 3 is required for app-chrome" >&2; exit 1; }
        exec python3 "$PLUGIN_DIR/scripts/one-bit-bureau-app-chrome.py" --plugin-dir "$PLUGIN_DIR" "$1"
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  update)
    require_install
    shift
    exec bash "$PLUGIN_DIR/update" "$@"
    ;;
  remove)
    require_install
    temporary=$(mktemp "${TMPDIR:-/tmp}/one-bit-bureau-uninstall.XXXXXX")
    cp -- "$PLUGIN_DIR/uninstall" "$temporary"
    export ONE_BIT_BUREAU_UNINSTALL_TEMP="$temporary"
    exec bash "$temporary"
    ;;
  overview)
    require_install
    omarchy-shell regionallyfamous.one-bit-bureau.overview toggle
    ;;
  dock)
    require_install
    shift
    (( $# > 0 )) || { usage >&2; exit 2; }
    omarchy-shell regionallyfamous.one-bit-bureau.dock "$@"
    ;;
  motion)
    require_install
    case "${2:-}" in
      reduce)
        omarchy bar set "$PLUGIN_ID" reducedMotion true --json
        ;;
      full)
        omarchy bar set "$PLUGIN_ID" reducedMotion false --json
        ;;
      status)
        omarchy-shell shell listShellConfig | jq -er --arg id "$PLUGIN_ID" '
          [
            .bar.layout.left[]?,
            .bar.layout.center[]?,
            .bar.layout.right[]?
          ]
          | map(select((if type == "object" then .id else . end) == $id))
          | first
          | if type == "object" and .reducedMotion == true then "reduced" else "full" end
        '
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  icon)
    require_install
    shift
    exec bash "$PLUGIN_DIR/components/dock/scripts/one-bit-bureau-icon" "$@"
    ;;
  font)
    require_install
    case "${2:-}" in
      list)
        printf '%s\n' \
          'krypton: Monaspace Krypton NF — recommended; includes Nerd Font symbols' \
          'departure: Departure Mono — sharper pixel look; no Nerd Font symbols'
        ;;
      use)
        case "${3:-}" in
          krypton) omarchy font set "Monaspace Krypton NF" ;;
          departure) omarchy font set "Departure Mono" ;;
          *) usage >&2; exit 2 ;;
        esac
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
