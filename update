#!/bin/bash

set -euo pipefail

PLUGIN_ID="io.github.regionallyfamous.one-bit-bureau"
PRODUCT_NAME="One-Bit Bureau"
THEME_NAME="one-bit-bureau"
EXPECTED_REPO_URL="https://github.com/RegionallyFamous/one-bit-bureau.git"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SECURE_IO="$SCRIPT_DIR/scripts/one_bit_bureau_secure_io.py"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
THEME_TARGET="$HOME/.config/omarchy/themes/$THEME_NAME"
THEME_SOURCES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/theme-sources"
ASSUME_YES=0
RECONCILE=0

fail() {
  echo "one-bit-bureau update: $*" >&2
  exit 1
}

theme_source_commands_available() {
  local command
  [[ -n ${OMARCHY_PATH:-} ]] || return 1
  for command in inspect install update detach; do
    [[ -x $OMARCHY_PATH/bin/omarchy-theme-source-$command ]] || return 1
  done
}

while (( $# > 0 )); do
  case "$1" in
    --yes | -y) ASSUME_YES=1 ;;
    --reconcile) RECONCILE=1 ;;
    -h | --help)
      echo "Usage: one-bit-bureau update [--yes]"
      exit 0
      ;;
    *) fail "unknown option: $1" ;;
  esac
  shift
done

command -v omarchy >/dev/null || fail "Omarchy is required"
command -v jq >/dev/null || fail "jq is required"
command -v python3 >/dev/null || fail "Python 3 is required"
[[ -f $SECURE_IO && ! -L $SECURE_IO ]] || fail "secure transaction helper is missing or unsafe"
[[ -d $PLUGIN_DIR/.git ]] || fail "this installation is not Git-managed; reinstall from the public repository"
state_snapshot=$(python3 "$SECURE_IO" install-state snapshot) || fail "ownership record is missing, unsafe, or over budget"
state_json=$(jq -ce '.record' <<<"$state_snapshot") || fail "ownership snapshot is invalid"
state_record_hash=$(jq -er '.recordHash | select(test("^[a-f0-9]{64}$"))' <<<"$state_snapshot") || fail "ownership snapshot hash is invalid"
jq -e --arg id "$PLUGIN_ID" --arg product "$PRODUCT_NAME" --arg theme "$THEME_NAME" --arg repo "$EXPECTED_REPO_URL" '
  .schemaVersion == 3 and
  .pluginId == $id and
  .product == $product and
  .theme == $theme and
  .pluginOwned == true and
  .themeOwned == true and
  (.installed | type == "object") and
  .installed.pluginOrigin == $repo and
  (.installed.pluginCommit | type == "string" and length > 0) and
  (.installed.themeInstallMode == "source" or .installed.themeInstallMode == "plugin-link") and
  (.installed.themeSourceId | type == "string") and
  .installed.themeSourceUrl == $repo and
  (.installed.themeSourceCommit | type == "string" and length > 0) and
  (
    if .installed.themeInstallMode == "source" then
      (.installed.themeSourceId | test("^[a-z0-9]+(-[a-z0-9]+)*-[a-f0-9]{12}$"))
    else
      .installed.themeSourceId == ""
    end
  ) and
  (.installed.commandHash | type == "string" and test("^[a-f0-9]{64}$"))
' <<<"$state_json" >/dev/null || fail "ownership record is invalid or is not an owned public installation"

theme_install_mode=$(jq -er '.installed.themeInstallMode' <<<"$state_json")
source_id=$(jq -er '.installed.themeSourceId' <<<"$state_json")
source_url=$(jq -er '.installed.themeSourceUrl' <<<"$state_json")
recorded_plugin_commit=$(jq -er '.installed.pluginCommit' <<<"$state_json")
recorded_theme_commit=$(jq -er '.installed.themeSourceCommit' <<<"$state_json")
actual_plugin_url=$(git -C "$PLUGIN_DIR" config --get remote.origin.url 2>/dev/null || true)
[[ $actual_plugin_url == "$EXPECTED_REPO_URL" ]] || fail "plugin checkout origin is not the canonical One-Bit Bureau repository"
[[ -z $(git -C "$PLUGIN_DIR" status --porcelain) ]] || fail "plugin checkout has local changes; commit or remove them before updating"
current_plugin_commit=$(git -C "$PLUGIN_DIR" rev-parse HEAD)
if (( ! RECONCILE )); then
  [[ $current_plugin_commit == "$recorded_plugin_commit" ]] || fail "plugin checkout changed outside One-Bit Bureau; reconcile ownership before updating"
fi
if [[ $theme_install_mode == "source" ]]; then
  theme_source_commands_available || fail "this installation requires Omarchy's complete theme-source API; update Omarchy before updating One-Bit Bureau"
  source_path="$THEME_SOURCES_DIR/$source_id"
  [[ -d $source_path/.git && ! -L $source_path ]] || fail "recorded theme source checkout is missing or unsafe"
  actual_source_url=$(git -C "$source_path" config --get remote.origin.url 2>/dev/null || true)
  [[ $actual_source_url == "$source_url" && $source_url == "$EXPECTED_REPO_URL" ]] || fail "recorded theme source does not own the installed repository"
  [[ -z $(git -C "$source_path" status --porcelain) ]] || fail "recorded theme source has local changes"
  actual_source_commit=$(git -C "$source_path" rev-parse HEAD)
  [[ $actual_source_commit == "$recorded_theme_commit" ]] || fail "recorded theme source changed outside One-Bit Bureau"
  expected_theme_path=$(realpath "$source_path/themes/$THEME_NAME" 2>/dev/null || true)
else
  expected_theme_path=$(realpath "$PLUGIN_DIR/themes/$THEME_NAME" 2>/dev/null || true)
fi
[[ -L $THEME_TARGET ]] || fail "One-Bit Bureau theme is not an owned link"
actual_theme_path=$(realpath "$THEME_TARGET" 2>/dev/null || true)
[[ -n $expected_theme_path && $actual_theme_path == "$expected_theme_path" ]] || fail "One-Bit Bureau theme link is not owned by its recorded installation mode"

if (( ! RECONCILE )); then
  arguments=(plugin update "$PLUGIN_ID")
  (( ! ASSUME_YES )) || arguments+=(--yes)
  omarchy "${arguments[@]}"
  exec bash "$PLUGIN_DIR/update" --reconcile
fi

active_theme=""
theme_state="$HOME/.local/state/omarchy/current/theme.name"
[[ ! -f $theme_state ]] || active_theme=$(<"$theme_state")

plugin_commit=$(git -C "$PLUGIN_DIR" rev-parse HEAD)
if [[ $theme_install_mode == "source" ]]; then
  theme_json=$(omarchy theme source update "$source_id" --json) || fail "theme source update failed"
  theme_commit=$(jq -er '.source.commit' <<<"$theme_json") || fail "theme source update returned no commit"
else
  [[ $(realpath "$THEME_TARGET" 2>/dev/null || true) == "$(realpath "$PLUGIN_DIR/themes/$THEME_NAME" 2>/dev/null || true)" ]] ||
    fail "plugin-linked theme stopped pointing at the updated plugin"
  theme_commit="$plugin_commit"
fi
[[ $theme_commit == "$plugin_commit" ]] || fail "plugin and theme stopped at different commits; rerun the update"

if [[ $active_theme == "$THEME_NAME" ]]; then
  omarchy theme set "$THEME_NAME"
fi

old_command_hash=$(jq -er '.installed.commandHash' <<<"$state_json")
new_command_hash=$(python3 "$SECURE_IO" command replace-if-owned --plugin-dir "$PLUGIN_DIR" --expected-hash "$old_command_hash") ||
  fail "could not safely reconcile the installed command"

jq --arg pluginCommit "$plugin_commit" --arg themeCommit "$theme_commit" --arg commandHash "$new_command_hash" '
  .installed.pluginCommit = $pluginCommit |
  .installed.themeSourceCommit = $themeCommit |
  .installed.commandHash = $commandHash
' <<<"$state_json" | python3 "$SECURE_IO" install-state write --expected-hash "$state_record_hash" >/dev/null

echo "One-Bit Bureau is up to date at $plugin_commit."
