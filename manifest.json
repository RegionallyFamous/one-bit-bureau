{
  "schemaVersion": 1,
  "id": "io.github.regionallyfamous.one-bit-bureau",
  "name": "One-Bit Bureau",
  "version": "1.1.2",
  "author": "RegionallyFamous",
  "license": "MIT",
  "description": "A one-bit Macintosh-inspired Omarchy workbench with desktop files, dock, Inspector, Window Ledger, workspace board, original icons, and theme.",
  "icon": "components/overview/assets/icon.png",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "components/desktop/Service.qml",
    "panel": "Experience.qml",
    "barWidget": "components/active-window/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Active application",
    "description": "Current application owner and secondary window title, placed beside the Omarchy menu.",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "iconSaturation": 100,
      "iconSize": 16,
      "maxWidth": 300,
      "reducedMotion": false,
      "showTitle": true
    },
    "schema": [
      {
        "key": "iconSaturation",
        "type": "integer",
        "label": "Icon saturation (%)",
        "min": 0,
        "max": 200,
        "step": 5,
        "defaultValue": 100
      },
      {
        "key": "iconSize",
        "type": "integer",
        "label": "Application icon size",
        "min": 12,
        "max": 22,
        "step": 1,
        "defaultValue": 16
      },
      {
        "key": "maxWidth",
        "type": "integer",
        "label": "Maximum title width",
        "min": 80,
        "max": 600,
        "step": 10,
        "defaultValue": 300
      },
      {
        "key": "reducedMotion",
        "type": "boolean",
        "label": "Reduce One-Bit Bureau motion",
        "defaultValue": false
      },
      {
        "key": "showTitle",
        "type": "boolean",
        "label": "Show window title",
        "defaultValue": true
      }
    ]
  }
}
