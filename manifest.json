{
  "schemaVersion": 1,
  "id": "io.github.regionallyfamous.alumina",
  "name": "Alumina Raster",
  "version": "0.4.0",
  "author": "RegionallyFamous",
  "license": "MIT",
  "description": "An object-first one-bit Omarchy experience with ImageGen-authored raster objects, an illustrated workbench, dock, overview, and matching native theme.",
  "icon": "components/overview/assets/icon.svg",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "components/desktop/Service.qml",
    "panel": "Experience.qml",
    "barWidget": "components/active-window/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Active application",
    "description": "Current application owner and secondary window title, placed beside the Omarchy menu.",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "iconSaturation": 0,
      "iconSize": 16,
      "maxWidth": 300,
      "showTitle": true
    },
    "schema": [
      {
        "key": "iconSaturation",
        "type": "integer",
        "label": "Icon saturation (%)",
        "min": 0,
        "max": 200,
        "step": 5,
        "defaultValue": 0
      },
      {
        "key": "iconSize",
        "type": "integer",
        "label": "Application icon size",
        "min": 12,
        "max": 22,
        "step": 1,
        "defaultValue": 16
      },
      {
        "key": "maxWidth",
        "type": "integer",
        "label": "Maximum title width",
        "min": 80,
        "max": 600,
        "step": 10,
        "defaultValue": 300
      },
      {
        "key": "showTitle",
        "type": "boolean",
        "label": "Show window title",
        "defaultValue": true
      }
    ]
  }
}
