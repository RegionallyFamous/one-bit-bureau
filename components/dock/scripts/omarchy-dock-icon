#!/bin/bash

set -euo pipefail

user_home="${HOME:?HOME is not set}"
config_dir="$user_home/.config/omarchy/one-bit-bureau"
map_file="$config_dir/dock-icons.json"
pins_file="$config_dir/dock-pinned.json"
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
state_helper="$script_dir/one-bit-bureau-state"
pack_dir="$script_dir/../assets/app-icons"
command_name="${0##*/}"

die() {
  printf '%s: %s\n' "$command_name" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  omarchy-dock-icon pack list
  omarchy-dock-icon pack set <app-id> <role>
  omarchy-dock-icon native <app-id>
  omarchy-dock-icon auto <app-id>
  omarchy-dock-icon clear <app-id>
  omarchy-dock-icon list
  omarchy-dock-icon folder
EOF
}

canonical_id() {
  local value="${1%.desktop}"
  [[ $value =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid app id: $1"
  (( ${#value} <= 160 )) || die "app id exceeds 160 characters"
  printf '%s' "$value"
}

list_pack() {
  printf '%s\n' \
    'files: Files' \
    'terminal: Terminal' \
    'browser: Web' \
    'code: Code' \
    'mail: Mail' \
    'chat: Chat' \
    'music: Music' \
    'video: Video' \
    'calendar: Calendar' \
    'settings: Controls' \
    'games: Games' \
    'notes: Notes'
}

write_mapping() {
  local app_id="$1" operation="$2" value="${3:-}"
  [[ ! -L $config_dir ]] || die "One-Bit Bureau config directory may not be a symlink"
  [[ ! -e $config_dir || -d $config_dir ]] || die "One-Bit Bureau config path is not a directory"
  mkdir -p "$config_dir"
  if [[ -n $value ]]; then
    python3 "$state_helper" write "$map_file" "$app_id" "$operation" "$value"
  else
    python3 "$state_helper" write "$map_file" "$app_id" "$operation"
  fi
}

command -v python3 >/dev/null || die "python3 is required"
[[ -f $state_helper && ! -L $state_helper ]] || die "One-Bit Bureau state helper is missing"

case "${1:-}" in
  pack)
    case "${2:-}" in
      list)
        (( $# == 2 )) || { usage; exit 2; }
        list_pack
        ;;
      set)
        (( $# == 4 )) || { usage; exit 2; }
        app_id=$(canonical_id "$3")
        role="$4"
        [[ $role =~ ^[a-z0-9-]+$ && -f $pack_dir/$role.png && ! -L $pack_dir/$role.png ]] || die "unknown One-Bit Bureau icon role: $role"
        write_mapping "$app_id" pack "$role"
        printf 'Set One-Bit Bureau %s icon for %s\n' "$role" "$app_id"
        ;;
      *) usage; exit 2 ;;
    esac
    ;;
  native)
    (( $# == 2 )) || { usage; exit 2; }
    app_id=$(canonical_id "$2")
    write_mapping "$app_id" native
    printf 'Set native icon for %s\n' "$app_id"
    ;;
  auto)
    (( $# == 2 )) || { usage; exit 2; }
    app_id=$(canonical_id "$2")
    write_mapping "$app_id" auto
    printf 'Restored automatic icon selection for %s\n' "$app_id"
    ;;
  clear)
    (( $# == 2 )) || { usage; exit 2; }
    app_id=$(canonical_id "$2")
    write_mapping "$app_id" clear
    printf 'Cleared custom icon for %s\n' "$app_id"
    ;;
  list)
    (( $# == 1 )) || { usage; exit 2; }
    [[ ! -L $config_dir ]] || die "One-Bit Bureau config directory may not be a symlink"
    python3 "$state_helper" list "$map_file" "$pins_file"
    ;;
  folder)
    (( $# == 1 )) || { usage; exit 2; }
    [[ ! -L $config_dir ]] || die "One-Bit Bureau config directory may not be a symlink"
    mkdir -p "$config_dir"
    xdg-open "$config_dir" >/dev/null 2>&1
    ;;
  -h | --help | help | "") usage ;;
  *) usage; exit 2 ;;
esac
