#!/usr/bin/python3
"""Descriptor-relative, bounded, durable state transactions for the shell."""

from __future__ import annotations

import json
import math
import os
import re
import secrets
import signal
import stat
import sys
from pathlib import Path


PACK_ROLES = {
    "application", "files", "terminal", "browser", "code", "mail", "chat",
    "music", "video", "calendar", "settings", "games", "notes", "theme",
    "document", "disk", "image", "spreadsheet", "presentation", "writer",
    "transfer", "paint", "video-edit", "broadcast", "calculator", "printer",
    "ocr", "project", "containers", "contacts", "maps", "social",
}
APP_ID = re.compile(r"^[A-Za-z0-9._-]{1,160}$")
FILES = {
    "icons": ("dock-icons.json", 1024 * 1024),
    "pins": ("dock-pinned.json", 64 * 1024),
    "settings": ("dock-settings.json", 16 * 1024),
    "positions": ("desktop-icon-positions.json", 64 * 1024),
}
MAX_ICONS = 256
MAX_PINNED = 128
MAX_SCREENS = 16
MAX_POSITIONS_PER_SCREEN = 256
MAX_STATE_OUTPUT = 256 * 1024
MAX_COORDINATE = 1_000_000


def deadline(_signum: int, _frame: object) -> None:
    raise TimeoutError("state transaction exceeded its deadline")


def bounded_text(value: object, byte_limit: int) -> str:
    return str(value or "").encode("utf-8")[:byte_limit].decode("utf-8", "ignore")


def nofollow_flag() -> int:
    return getattr(os, "O_NOFOLLOW", 0)


def validate_directory(descriptor: int, *, private: bool) -> None:
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode):
        raise SystemExit("state parent must be a directory")
    if metadata.st_uid != os.getuid():
        raise SystemExit("state parent must be owned by the current user")
    if metadata.st_mode & 0o022:
        raise SystemExit("state parent may not be group or world writable")
    if private and metadata.st_mode & 0o077:
        os.fchmod(descriptor, 0o700)


def open_child_directory(parent_fd: int, name: str, *, create: bool, private: bool) -> int:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow_flag()
    try:
        descriptor = os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        if not create:
            raise
        os.mkdir(name, 0o700 if private else 0o755, dir_fd=parent_fd)
        os.fsync(parent_fd)
        descriptor = os.open(name, flags, dir_fd=parent_fd)
    validate_directory(descriptor, private=private)
    return descriptor


def open_state_directory(*, create: bool) -> int:
    raw_home = os.environ.get("HOME", "")
    if not raw_home or not os.path.isabs(raw_home) or "\x00" in raw_home:
        raise SystemExit("HOME must name an absolute directory")
    home_fd = os.open(
        raw_home,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow_flag(),
    )
    try:
        validate_directory(home_fd, private=False)
        config_fd = open_child_directory(
            home_fd, ".config", create=create, private=False
        )
    finally:
        os.close(home_fd)
    try:
        omarchy_fd = open_child_directory(
            config_fd, "omarchy", create=create, private=False
        )
    finally:
        os.close(config_fd)
    try:
        state_fd = open_child_directory(
            omarchy_fd, "one-bit-bureau", create=create, private=True
        )
    finally:
        os.close(omarchy_fd)
    return state_fd


def read_bytes(directory_fd: int, name: str, byte_limit: int) -> bytes | None:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow_flag()
    try:
        descriptor = os.open(name, flags, dir_fd=directory_fd)
    except FileNotFoundError:
        return None
    except OSError:
        return None
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1
            or metadata.st_size > byte_limit
        ):
            return None
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(65_536, byte_limit + 1 - total))
            if not chunk:
                return b"".join(chunks)
            total += len(chunk)
            if total > byte_limit:
                return None
            chunks.append(chunk)
    except (BlockingIOError, OSError):
        return None
    finally:
        os.close(descriptor)


def read_json(directory_fd: int, kind: str, fallback: object) -> object:
    name, byte_limit = FILES[kind]
    raw = read_bytes(directory_fd, name, byte_limit)
    if raw is None:
        return fallback
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return fallback


def safe_id(value: object) -> str:
    candidate = str(value or "").removesuffix(".desktop")
    return candidate if APP_ID.fullmatch(candidate) else ""


def shape_ids(value: object) -> list[str]:
    if not isinstance(value, list):
        return []
    output: list[str] = []
    seen: set[str] = set()
    for raw in value:
        candidate = safe_id(raw)
        if not candidate or candidate in seen:
            continue
        output.append(candidate)
        seen.add(candidate)
        if len(output) >= MAX_PINNED:
            break
    return output


def shape_icons(value: object) -> dict[str, object]:
    if not isinstance(value, dict):
        return {}
    output: dict[str, object] = {}
    for raw_id, raw_entry in value.items():
        app_id = safe_id(raw_id)
        if not app_id:
            continue
        if isinstance(raw_entry, str):
            filename = bounded_text(raw_entry, 255)
            if filename and Path(filename).name == filename:
                output[app_id] = filename
        elif isinstance(raw_entry, dict):
            entry: dict[str, str] = {}
            filename = bounded_text(raw_entry.get("file"), 255)
            pack = bounded_text(raw_entry.get("pack"), 32)
            mode = bounded_text(raw_entry.get("mode"), 16)
            if filename and Path(filename).name == filename:
                entry["file"] = filename
            if pack in PACK_ROLES:
                entry["pack"] = pack
            if mode == "native":
                entry["mode"] = mode
            if entry:
                output[app_id] = entry
        if len(output) >= MAX_ICONS:
            break
    return output


def shape_pins(value: object) -> dict[str, object]:
    if isinstance(value, list):
        return {"version": 1, "pinned": shape_ids(value), "order": []}
    if not isinstance(value, dict):
        return {}
    return {
        "version": 1,
        "pinned": shape_ids(value.get("pinned")),
        "order": shape_ids(value.get("order")),
    }


def shape_settings(value: object) -> dict[str, object]:
    if not isinstance(value, dict):
        return {}
    output: dict[str, object] = {}
    if isinstance(value.get("autoHide"), bool):
        output["autoHide"] = value["autoHide"]
    screen = bounded_text(value.get("screenName"), 160)
    if screen:
        output["screenName"] = screen
    return output


def shape_positions(value: object) -> dict[str, dict[str, dict[str, int]]]:
    if not isinstance(value, dict):
        raise ValueError("positions root must be an object")
    if len(value) > MAX_SCREENS:
        raise ValueError("positions exceed the screen ceiling")
    output: dict[str, dict[str, dict[str, int]]] = {}
    for raw_screen, raw_entries in value.items():
        if not isinstance(raw_screen, str) or not isinstance(raw_entries, dict):
            raise ValueError("positions contain an invalid screen record")
        if len(raw_entries) > MAX_POSITIONS_PER_SCREEN:
            raise ValueError("positions exceed the per-screen item ceiling")
        screen = bounded_text(raw_screen, 160)
        if not screen or screen != raw_screen or screen in output:
            raise ValueError("positions contain an invalid screen key")
        entries: dict[str, dict[str, int]] = {}
        for raw_id, raw_position in raw_entries.items():
            if not isinstance(raw_id, str):
                raise ValueError("positions contain a non-string item key")
            item_id = bounded_text(raw_id, 255)
            if (
                not item_id
                or item_id != raw_id
                or item_id in entries
                or not isinstance(raw_position, dict)
            ):
                raise ValueError("positions contain an invalid item record")
            if set(raw_position) != {"x", "y"}:
                raise ValueError("positions must contain exactly x and y")
            x = raw_position.get("x")
            y = raw_position.get("y")
            if (
                isinstance(x, bool)
                or isinstance(y, bool)
                or not isinstance(x, (int, float))
                or not isinstance(y, (int, float))
                or not math.isfinite(x)
                or not math.isfinite(y)
            ):
                raise ValueError("positions coordinates must be finite numbers")
            x_int = int(round(x))
            y_int = int(round(y))
            if abs(x_int) > MAX_COORDINATE or abs(y_int) > MAX_COORDINATE:
                raise ValueError("positions coordinates exceed the ceiling")
            entries[item_id] = {"x": x_int, "y": y_int}
        output[screen] = entries
    return output


def encode_json(value: object, byte_limit: int) -> bytes:
    encoded = (
        json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("utf-8")
    if len(encoded) > byte_limit:
        raise SystemExit("state exceeds its byte budget")
    return encoded


def parse_argument_json(raw: str, byte_limit: int) -> object:
    encoded = raw.encode("utf-8")
    if len(encoded) > byte_limit:
        raise SystemExit("state input exceeds its byte budget")
    try:
        return json.loads(encoded)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SystemExit("state input is not valid JSON") from error


def validate_existing_target(directory_fd: int, name: str) -> None:
    try:
        metadata = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_nlink != 1
    ):
        raise SystemExit("state target must be a private regular file")


def atomic_write(directory_fd: int, kind: str, encoded: bytes) -> None:
    name, byte_limit = FILES[kind]
    if len(encoded) > byte_limit:
        raise SystemExit("state exceeds its byte budget")
    validate_existing_target(directory_fd, name)
    temporary = f".{name}.tmp-{os.getpid()}-{secrets.token_hex(8)}"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | nofollow_flag()
    descriptor = os.open(temporary, flags, 0o600, dir_fd=directory_fd)
    try:
        view = memoryview(encoded)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
        os.fsync(descriptor)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise SystemExit("temporary state file failed validation")
    finally:
        os.close(descriptor)
    try:
        validate_existing_target(directory_fd, name)
        os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory_fd)
        except FileNotFoundError:
            pass


def update_icon_mapping(
    directory_fd: int, app_id: str, operation: str, value: str = ""
) -> None:
    canonical = safe_id(app_id)
    if not canonical:
        raise SystemExit("invalid app id")
    icons = shape_icons(read_json(directory_fd, "icons", {}))
    if operation == "pack":
        if value not in PACK_ROLES:
            raise SystemExit("unknown One-Bit Bureau icon role")
        if canonical not in icons and len(icons) >= MAX_ICONS:
            raise SystemExit("icon mapping already contains 256 entries")
        icons[canonical] = {"pack": value}
    elif operation == "native":
        if canonical not in icons and len(icons) >= MAX_ICONS:
            raise SystemExit("icon mapping already contains 256 entries")
        icons[canonical] = {"mode": "native"}
    elif operation in {"auto", "clear"}:
        icons.pop(canonical, None)
    else:
        raise SystemExit("unknown icon mapping operation")
    atomic_write(directory_fd, "icons", encode_json(icons, FILES["icons"][1]))


def list_icons(directory_fd: int) -> None:
    icons = shape_icons(read_json(directory_fd, "icons", {}))
    pins = shape_pins(read_json(directory_fd, "pins", {})).get("pinned", [])
    lines: list[str] = []
    for app_id in pins:
        entry = icons.get(app_id, {})
        if isinstance(entry, str):
            choice = entry
        elif isinstance(entry, dict) and entry.get("pack"):
            choice = f"One-Bit Bureau {entry['pack']}"
        elif isinstance(entry, dict) and entry.get("mode") == "native":
            choice = "native icon"
        else:
            choice = "automatic"
        lines.append(f"{app_id}: {choice}")
    encoded = ("\n".join(lines) + ("\n" if lines else "")).encode("utf-8")
    if len(encoded) > MAX_STATE_OUTPUT:
        raise SystemExit("state listing exceeded its output budget")
    os.write(1, encoded)


def main() -> None:
    signal.signal(signal.SIGALRM, deadline)
    signal.alarm(3)
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    directory_fd = open_state_directory(create=True)
    try:
        if command == "read" and len(sys.argv) == 3 and sys.argv[2] == "dock":
            pins_raw = read_json(directory_fd, "pins", None)
            shaped = {
                "icons": shape_icons(read_json(directory_fd, "icons", {})),
                "pins": shape_pins(pins_raw) if pins_raw is not None else {},
                "settings": shape_settings(read_json(directory_fd, "settings", {})),
            }
            os.write(1, encode_json(shaped, MAX_STATE_OUTPUT))
        elif command == "read" and len(sys.argv) == 3 and sys.argv[2] == "positions":
            try:
                shaped = shape_positions(read_json(directory_fd, "positions", {}))
            except ValueError:
                shaped = {}
            os.write(1, encode_json(shaped, FILES["positions"][1]))
        elif command == "write" and len(sys.argv) in {5, 6} and sys.argv[2] == "icon":
            update_icon_mapping(
                directory_fd,
                sys.argv[3],
                sys.argv[4],
                sys.argv[5] if len(sys.argv) == 6 else "",
            )
        elif command == "write" and len(sys.argv) == 4 and sys.argv[2] == "pins":
            value = shape_pins(parse_argument_json(sys.argv[3], FILES["pins"][1]))
            atomic_write(directory_fd, "pins", encode_json(value, FILES["pins"][1]))
        elif command == "write" and len(sys.argv) == 4 and sys.argv[2] == "settings":
            value = shape_settings(parse_argument_json(sys.argv[3], FILES["settings"][1]))
            atomic_write(
                directory_fd, "settings", encode_json(value, FILES["settings"][1])
            )
        elif command == "write" and len(sys.argv) == 4 and sys.argv[2] == "positions":
            try:
                value = shape_positions(
                    parse_argument_json(sys.argv[3], FILES["positions"][1])
                )
            except ValueError as error:
                raise SystemExit(str(error)) from error
            atomic_write(
                directory_fd, "positions", encode_json(value, FILES["positions"][1])
            )
        elif command == "list" and len(sys.argv) == 2:
            list_icons(directory_fd)
        else:
            raise SystemExit(
                "usage: one-bit-bureau-state read dock|positions | "
                "write icon|pins|settings|positions ... | list"
            )
    finally:
        os.close(directory_fd)


if __name__ == "__main__":
    main()
