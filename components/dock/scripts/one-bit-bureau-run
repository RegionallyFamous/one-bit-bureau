#!/usr/bin/python3

"""Run one trusted helper with a deadline and process-group containment."""

from __future__ import annotations

import os
import ctypes
import signal
import subprocess
import sys
import time


def usage() -> None:
    raise SystemExit("usage: one-bit-bureau-run TIMEOUT_MS GRACE_MS -- COMMAND [ARG ...]")


def bounded_milliseconds(raw: str, minimum: int, maximum: int, label: str) -> int:
    try:
        value = int(raw)
    except ValueError as error:
        raise SystemExit(f"{label} must be an integer") from error
    if not minimum <= value <= maximum:
        raise SystemExit(f"{label} must be between {minimum} and {maximum} milliseconds")
    return value


def signal_group(process: subprocess.Popen[bytes], signum: int) -> None:
    try:
        os.killpg(process.pid, signum)
    except ProcessLookupError:
        pass


def stop_and_reap(process: subprocess.Popen[bytes], grace_seconds: float) -> None:
    signal_group(process, signal.SIGTERM)
    grace_deadline = time.monotonic() + grace_seconds
    while process.poll() is None and time.monotonic() < grace_deadline:
        time.sleep(0.01)

    # Kill the process group even if the direct child exited during grace: a
    # descendant may still be alive in the group. The controller owns only the
    # fresh session it created, so the target identity cannot be reused here.
    signal_group(process, signal.SIGKILL)
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        signal_group(process, signal.SIGKILL)
        process.wait()


def main() -> int:
    if len(sys.argv) < 5 or sys.argv[3] != "--":
        usage()
    timeout_seconds = bounded_milliseconds(sys.argv[1], 50, 60000, "timeout") / 1000
    grace_seconds = bounded_milliseconds(sys.argv[2], 10, 2000, "grace") / 1000
    command = sys.argv[4:]
    if not command:
        usage()

    requested_signal = 0

    def request_stop(signum: int, _frame: object) -> None:
        nonlocal requested_signal
        requested_signal = signum

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    child_setup = None
    start_new_session = True
    if sys.platform.startswith("linux"):
        # PR_SET_PDEATHSIG is the independent kernel cleanup owner. The task
        # cannot exec until this fail-closed gate is installed, and the PPID
        # check closes the fork-to-prctl race if the controller dies first.
        owner_pid = os.getpid()
        libc = ctypes.CDLL(None, use_errno=True)
        gate_delay = min(max(int(os.environ.get("ONE_BIT_BUREAU_RUN_TEST_GATE_DELAY_MS", "0")), 0), 1000) / 1000

        def prepare_contained_child() -> None:
            if gate_delay:
                time.sleep(gate_delay)
            if libc.prctl(1, signal.SIGKILL, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
                os._exit(125)
            if os.getppid() != owner_pid:
                os.kill(os.getpid(), signal.SIGKILL)
            os.setsid()

        child_setup = prepare_contained_child
        start_new_session = False

    try:
        process = subprocess.Popen(
            command,
            preexec_fn=child_setup,
            start_new_session=start_new_session,
        )
    except OSError as error:
        print(f"one-bit-bureau-run: could not start helper: {error}", file=sys.stderr)
        return 126

    deadline = time.monotonic() + timeout_seconds
    while True:
        return_code = process.poll()
        if return_code is not None:
            return return_code if return_code >= 0 else 128 - return_code
        if requested_signal:
            stop_and_reap(process, grace_seconds)
            return 128 + requested_signal
        if time.monotonic() >= deadline:
            stop_and_reap(process, grace_seconds)
            print("one-bit-bureau-run: helper exceeded its deadline", file=sys.stderr)
            return 124
        time.sleep(0.02)


if __name__ == "__main__":
    raise SystemExit(main())
