#!/usr/bin/python3
"""Bounded local filesystem operations for the One-Bit Bureau desktop.

The QML surface treats this program as a transaction boundary.  Every invocation
prints exactly one JSON receipt, mutations are journaled before they start, and
Undo is offered only for unchanged regular-file moves that can be proven safe.
"""

from __future__ import annotations

import argparse
import ctypes
import errno
import fcntl
import hashlib
import json
import mimetypes
import os
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterator
from urllib.parse import unquote_to_bytes, urlparse

_BIN_DIR = str(Path(__file__).resolve().parent)
if _BIN_DIR not in sys.path:
    sys.path.insert(0, _BIN_DIR)

from desktop_policy import (
    DesktopDisabledError,
    enforce_untrusted_launcher,
    require_desktop_directory,
)


SCHEMA_VERSION = 1
MAX_SOURCES = 64
MAX_RAW_ARGS = 70
MAX_RAW_ARG_BYTES = 1024
MAX_PATH_BYTES = 1024
MAX_NAME_BYTES = 255
MAX_OUTPUT_BYTES = 256 * 1024
MAX_JOURNAL_BYTES = 512 * 1024
MAX_ERROR_BYTES = 240
MAX_TREE_ENTRIES = 20_000
MAX_UNDO_FILE_BYTES = 64 * 1024 * 1024
MAX_UNIQUE_ATTEMPTS = 10_000
CHILD_TIMEOUT_SECONDS = 30
CHILD_CANCEL_GRACE_SECONDS = 0.5
MAX_OPERATION_SECONDS = 10 * 60
OPERATION_ID_RE = re.compile(r"^[a-f0-9]{32}$")
URI_SCHEME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
PR_SET_PDEATHSIG = 1


class RequestError(Exception):
    def __init__(self, code: str, message: str, *, exit_code: int = 2):
        super().__init__(message)
        self.code = code
        self.exit_code = exit_code


class ItemError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code


class OperationCancelled(ItemError):
    pass


class ReceiptParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise RequestError("invalid_arguments", message)

    def exit(self, status: int = 0, message: str | None = None) -> None:
        raise RequestError("invalid_arguments", message or "Help requested")


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def _bounded_text(value: Any, limit: int = MAX_ERROR_BYTES) -> str:
    text = " ".join(
        str(value or "").replace("\x00", " ").replace("\r", " ").replace("\n", " ").split()
    )
    encoded = text.encode("utf-8", "replace")
    if len(encoded) <= limit:
        return text
    return encoded[:limit].decode("utf-8", "ignore").rstrip()


def _error(code: str, message: Any) -> dict[str, str]:
    return {"code": code, "message": _bounded_text(message)}


def _json_bytes(payload: dict[str, Any], *, journal: bool = False) -> bytes:
    encoded = json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")
    limit = MAX_JOURNAL_BYTES if journal else MAX_OUTPUT_BYTES
    if len(encoded) > limit:
        raise RequestError("output_too_large", f"Structured result exceeds {limit} bytes")
    return encoded


def emit(payload: dict[str, Any]) -> None:
    sys.stdout.buffer.write(_json_bytes(payload) + b"\n")
    sys.stdout.buffer.flush()


def _failed_receipt(command: str, error: Exception) -> dict[str, Any]:
    code = error.code if isinstance(error, (RequestError, ItemError)) else "internal_error"
    return {
        "schemaVersion": SCHEMA_VERSION,
        "command": command,
        "ok": False,
        "state": "failed",
        "undoable": False,
        "error": _error(code, error),
    }


def _kill_child_when_parent_dies() -> None:
    """Keep a cancelled shell process from orphaning a mutating gio child."""

    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
        os._exit(127)
    # Close the race where the QML-owned parent exits between fork and prctl.
    if os.getppid() == 1:
        os._exit(127)


def _validate_raw_argv(argv: list[str]) -> None:
    if len(argv) > MAX_RAW_ARGS:
        raise RequestError("too_many_arguments", f"At most {MAX_RAW_ARGS} arguments are allowed")
    for value in argv:
        if "\x00" in value:
            raise RequestError("invalid_argument", "Arguments cannot contain NUL bytes")
        if any(ord(character) < 32 or ord(character) == 127 for character in value):
            raise RequestError("invalid_argument", "Arguments cannot contain control characters")
        if len(value.encode("utf-8", "surrogateescape")) > MAX_RAW_ARG_BYTES:
            raise RequestError(
                "argument_too_long",
                f"Each raw argument is limited to {MAX_RAW_ARG_BYTES} bytes",
            )


def _decode_local_file_uri(raw: str) -> str:
    parsed = urlparse(raw)
    if parsed.scheme.lower() != "file":
        raise RequestError("remote_uri", "Only local file paths are accepted")
    if parsed.netloc.lower() not in {"", "localhost"}:
        raise RequestError("remote_uri", "Remote file URIs are not accepted")
    if parsed.query or parsed.fragment:
        raise RequestError("invalid_path", "File URIs cannot contain a query or fragment")
    try:
        return unquote_to_bytes(parsed.path).decode("utf-8", "strict")
    except UnicodeDecodeError as error:
        raise RequestError("invalid_path", "File URI is not valid UTF-8") from error


def local_path(raw: str) -> Path:
    if not raw:
        raise RequestError("empty_path", "Path is empty")
    text = _decode_local_file_uri(raw) if URI_SCHEME_RE.match(raw) else raw
    if URI_SCHEME_RE.match(text) or "://" in text:
        raise RequestError("remote_uri", "Only local file paths are accepted")
    if "\x00" in text:
        raise RequestError("invalid_path", "Path contains a NUL byte")
    expanded = os.path.expanduser(text)
    if not os.path.isabs(expanded) or expanded.startswith("//"):
        raise RequestError("invalid_path", "Path must be an absolute local path")
    path = Path(os.path.abspath(expanded))
    if len(os.fsencode(path)) > MAX_PATH_BYTES:
        raise RequestError("path_too_long", f"Paths are limited to {MAX_PATH_BYTES} bytes")
    name = path.name
    if name and len(os.fsencode(name)) > MAX_NAME_BYTES:
        raise RequestError("name_too_long", f"Names are limited to {MAX_NAME_BYTES} bytes")
    return path


def _home_path() -> Path:
    raw = os.environ.get("HOME") or str(Path.home())
    return local_path(raw).resolve()


def desktop_dir() -> Path:
    try:
        return require_desktop_directory()
    except DesktopDisabledError as error:
        raise RequestError("desktop_disabled", str(error)) from error


def _lstat_supported(path: Path, *, allow_symlink: bool = False) -> os.stat_result:
    try:
        info = path.lstat()
    except FileNotFoundError as error:
        raise ItemError("not_found", f"Item no longer exists: {path}") from error
    except OSError as error:
        raise ItemError("stat_failed", f"Cannot inspect {path.name}: {error}") from error
    if stat.S_ISLNK(info.st_mode):
        if allow_symlink:
            return info
        raise ItemError("unsafe_symlink", f"Symbolic links are not accepted: {path.name}")
    if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
        raise ItemError("unsupported_type", f"Unsupported filesystem item: {path.name}")
    return info


def _validate_tree(path: Path) -> None:
    top = _lstat_supported(path)
    if stat.S_ISREG(top.st_mode):
        return
    count = 1
    try:
        for root, directories, files in os.walk(path, topdown=True, followlinks=False):
            root_path = Path(root)
            for name in directories + files:
                count += 1
                if count > MAX_TREE_ENTRIES:
                    raise ItemError(
                        "tree_too_large",
                        f"Folder contains more than {MAX_TREE_ENTRIES} entries",
                    )
                _lstat_supported(root_path / name)
    except ItemError:
        raise
    except OSError as error:
        raise ItemError("scan_failed", f"Could not validate {path.name}: {error}") from error


def _validate_destination(raw: str) -> Path:
    path = local_path(raw)
    info = _lstat_supported(path)
    if not stat.S_ISDIR(info.st_mode):
        raise RequestError("invalid_destination", "Destination must be a local folder")
    resolved = path.resolve()
    if not os.access(resolved, os.W_OK | os.X_OK):
        raise RequestError("destination_not_writable", "Destination is not writable")
    return resolved


def _is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def _preflight_source(path: Path, destination: Path) -> None:
    _validate_tree(path)
    resolved = path.resolve()
    if resolved == destination:
        raise ItemError("same_file", "Source and destination are the same folder")
    if path.parent.resolve() == destination:
        raise ItemError("same_folder", f"{path.name} is already in the destination folder")
    if _is_relative_to(destination, resolved):
        raise ItemError("destination_recursion", "A folder cannot be placed inside itself")


def _truncate_name(text: str, byte_limit: int) -> str:
    encoded = text.encode("utf-8")
    if len(encoded) <= byte_limit:
        return text
    return encoded[:byte_limit].decode("utf-8", "ignore")


def _numbered_name(name: str, number: int) -> str:
    suffix = Path(name).suffix if not name.startswith(".") else ""
    stem = name[: -len(suffix)] if suffix else name
    counter = f" {number}"
    room = MAX_NAME_BYTES - len((counter + suffix).encode("utf-8"))
    if room < 1:
        suffix = ""
        room = MAX_NAME_BYTES - len(counter.encode("utf-8"))
    return f"{_truncate_name(stem, room)}{counter}{suffix}"


def _candidate(destination: Path, name: str, attempt: int) -> Path:
    return destination / (name if attempt == 1 else _numbered_name(name, attempt))


def _copy_regular(
    source: Path,
    destination: Path,
    control: "OperationControl | None" = None,
) -> None:
    source_fd = -1
    destination_fd = -1
    created = False
    try:
        if control is not None:
            control.check()
        source_fd = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        before = os.fstat(source_fd)
        if not stat.S_ISREG(before.st_mode):
            raise ItemError("source_changed", f"Source type changed: {source.name}")
        destination_fd = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            stat.S_IMODE(before.st_mode) or 0o600,
        )
        created = True
        while True:
            if control is not None:
                control.check()
            block = os.read(source_fd, 1024 * 1024)
            if not block:
                break
            view = memoryview(block)
            while view:
                written = os.write(destination_fd, view)
                view = view[written:]
        os.fsync(destination_fd)
        after = os.fstat(source_fd)
        identity_before = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
        identity_after = (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        if identity_before != identity_after:
            raise ItemError("source_changed", f"Source changed while copying: {source.name}")
        os.fchmod(destination_fd, stat.S_IMODE(before.st_mode))
        os.utime(destination_fd, ns=(before.st_atime_ns, before.st_mtime_ns))
    except FileExistsError:
        raise
    except (ItemError, OSError):
        if created:
            try:
                destination.unlink()
            except OSError:
                pass
        raise
    finally:
        if destination_fd >= 0:
            os.close(destination_fd)
        if source_fd >= 0:
            os.close(source_fd)


def _copy_directory(
    source: Path,
    destination: Path,
    control: "OperationControl | None" = None,
) -> None:
    created = False
    try:
        if control is not None:
            control.check()
        destination.mkdir(mode=0o700)
        created = True
        entry_count = 1
        directories: list[tuple[Path, Path]] = [(source, destination)]
        copied_directories: list[tuple[Path, Path]] = []
        while directories:
            source_dir, destination_dir = directories.pop()
            copied_directories.append((source_dir, destination_dir))
            with os.scandir(source_dir) as entries:
                for entry in entries:
                    if control is not None:
                        control.check()
                    entry_count += 1
                    if entry_count > MAX_TREE_ENTRIES:
                        raise ItemError(
                            "tree_too_large",
                            f"Folder contains more than {MAX_TREE_ENTRIES} entries",
                        )
                    child_source = source_dir / entry.name
                    child_destination = destination_dir / entry.name
                    info = child_source.lstat()
                    if stat.S_ISLNK(info.st_mode):
                        raise ItemError(
                            "unsafe_symlink",
                            f"Symbolic links are not accepted: {child_source.name}",
                        )
                    if stat.S_ISDIR(info.st_mode):
                        child_destination.mkdir(mode=0o700)
                        directories.append((child_source, child_destination))
                    elif stat.S_ISREG(info.st_mode):
                        _copy_regular(child_source, child_destination, control)
                    else:
                        raise ItemError(
                            "unsupported_type",
                            f"Unsupported filesystem item: {child_source.name}",
                        )
        for source_dir, destination_dir in reversed(copied_directories):
            shutil.copystat(source_dir, destination_dir, follow_symlinks=False)
        _validate_tree(destination)
    except FileExistsError:
        raise
    except Exception:
        if created:
            shutil.rmtree(destination, ignore_errors=True)
        raise


def _copy_to_unique(
    source: Path,
    destination: Path,
    control: "OperationControl | None" = None,
) -> Path:
    source_info = source.lstat()
    for attempt in range(1, MAX_UNIQUE_ATTEMPTS + 1):
        target = _candidate(destination, source.name, attempt)
        try:
            if stat.S_ISDIR(source_info.st_mode):
                _copy_directory(source, target, control)
            else:
                _copy_regular(source, target, control)
            return target
        except FileExistsError:
            continue
    raise ItemError("name_exhausted", f"Could not find a unique name for {source.name}")


def _launcher_to_desktop(
    source: Path,
    destination: Path,
    *,
    move: bool,
    control: "OperationControl | None" = None,
) -> Path:
    """Transfer a launcher only after its Desktop copy is provably untrusted."""

    for attempt in range(1, MAX_UNIQUE_ATTEMPTS + 1):
        target = _candidate(destination, source.name, attempt)
        try:
            _copy_regular(source, target, control)
        except FileExistsError:
            continue
        try:
            if control is not None:
                control.check()
            enforce_untrusted_launcher(target)
            if control is not None:
                control.check()
            if move:
                source.unlink()
            return target
        except Exception:
            try:
                target.unlink()
            except OSError:
                pass
            raise
    raise ItemError("name_exhausted", f"Could not find a unique name for {source.name}")


def _rename_noreplace(source: Path, destination: Path) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is not None:
        renameat2.argtypes = [
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_uint,
        ]
        renameat2.restype = ctypes.c_int
        result = renameat2(
            -100,
            os.fsencode(source),
            -100,
            os.fsencode(destination),
            1,
        )
    else:
        renamex_np = getattr(libc, "renamex_np", None)
        if renamex_np is None:
            raise OSError(errno.ENOSYS, "No-replace rename is unavailable")
        renamex_np.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        renamex_np.restype = ctypes.c_int
        # Darwin's RENAME_EXCL provides the same no-overwrite guarantee.
        result = renamex_np(os.fsencode(source), os.fsencode(destination), 0x00000004)
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), str(destination))


def _remove_created(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
        shutil.rmtree(path)
    else:
        path.unlink()


def _move_exact(
    source: Path,
    destination: Path,
    control: "OperationControl | None" = None,
) -> None:
    if control is not None:
        control.check()
    try:
        _rename_noreplace(source, destination)
        return
    except OSError as error:
        if error.errno == errno.EEXIST:
            raise FileExistsError(errno.EEXIST, "Destination exists", str(destination)) from error
        if error.errno not in {errno.EXDEV, errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP}:
            raise

    # Portable/cross-filesystem fallback.  The destination is reserved with
    # O_EXCL/mkdir, and is rolled back if removing the source does not finish.
    source_info = source.lstat()
    if stat.S_ISDIR(source_info.st_mode):
        _copy_directory(source, destination, control)
    else:
        _copy_regular(source, destination, control)
    try:
        if control is not None:
            control.check()
        if stat.S_ISDIR(source_info.st_mode):
            shutil.rmtree(source)
        else:
            source.unlink()
    except Exception:
        try:
            _remove_created(destination)
        except Exception as rollback_error:
            raise ItemError(
                "rollback_failed",
                f"Move failed and its destination could not be removed: {rollback_error}",
            )
        raise


def _move_to_unique(
    source: Path,
    destination: Path,
    control: "OperationControl | None" = None,
) -> Path:
    for attempt in range(1, MAX_UNIQUE_ATTEMPTS + 1):
        target = _candidate(destination, source.name, attempt)
        try:
            _move_exact(source, target, control)
            return target
        except FileExistsError:
            continue
    raise ItemError("name_exhausted", f"Could not find a unique name for {source.name}")


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode):
            raise ItemError("undo_not_provable", "Only regular-file moves can be undone")
        if before.st_size > MAX_UNDO_FILE_BYTES:
            raise ItemError("undo_not_provable", "File is too large for a safe Undo proof")
        while True:
            block = os.read(fd, 1024 * 1024)
            if not block:
                break
            digest.update(block)
        after = os.fstat(fd)
        if (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            raise ItemError("undo_not_provable", "File changed while its Undo proof was recorded")
        return digest.hexdigest()
    finally:
        os.close(fd)


def _move_proof(source: Path, destination: Path) -> dict[str, Any] | None:
    try:
        if destination.suffix.lower() == ".desktop":
            return None
        info = destination.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
            return None
        if info.st_size > MAX_UNDO_FILE_BYTES:
            return None
        digest = _sha256(destination)
        after = destination.lstat()
        if (
            info.st_dev,
            info.st_ino,
            info.st_size,
            info.st_mtime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            return None
        return {
            "source": str(source),
            "destination": str(destination),
            "device": after.st_dev,
            "inode": after.st_ino,
            "size": after.st_size,
            "mtimeNs": after.st_mtime_ns,
            "ctimeNs": after.st_ctime_ns,
            "mode": stat.S_IMODE(after.st_mode),
            "uid": after.st_uid,
            "gid": after.st_gid,
            "sha256": digest,
            "undone": False,
        }
    except (OSError, ItemError):
        return None


def _proof_matches(proof: dict[str, Any]) -> bool:
    if not _proof_metadata_matches(proof):
        return False
    path = Path(proof["destination"])
    try:
        return secrets.compare_digest(_sha256(path), proof["sha256"])
    except (OSError, ItemError, KeyError, TypeError):
        return False


def _proof_metadata_matches(proof: dict[str, Any]) -> bool:
    path = Path(proof["destination"])
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
            return False
        if (
            info.st_dev != proof["device"]
            or info.st_ino != proof["inode"]
            or info.st_size != proof["size"]
            or info.st_mtime_ns != proof["mtimeNs"]
            or info.st_ctime_ns != proof["ctimeNs"]
            or stat.S_IMODE(info.st_mode) != proof["mode"]
            or info.st_uid != proof["uid"]
            or info.st_gid != proof["gid"]
        ):
            return False
        return True
    except (OSError, ItemError, KeyError, TypeError):
        return False


def _state_directory() -> Path:
    raw = os.environ.get("XDG_STATE_HOME")
    base = local_path(raw).resolve() if raw else _home_path() / ".local/state"
    directory = base / "one-bit-bureau" / "desktop-operations"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = directory.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise RequestError("unsafe_state_directory", "Operation journal path is not a real folder")
    if info.st_uid != os.getuid():
        raise RequestError("unsafe_state_directory", "Operation journal is owned by another user")
    try:
        directory.chmod(0o700)
    except OSError:
        pass
    return directory


def _validate_operation_id(operation_id: str) -> str:
    if not OPERATION_ID_RE.fullmatch(operation_id or ""):
        raise RequestError("invalid_operation_id", "Operation ID is invalid")
    return operation_id


def _journal_path(operation_id: str) -> Path:
    return _state_directory() / f"{_validate_operation_id(operation_id)}.json"


def _cancel_path(operation_id: str) -> Path:
    return _state_directory() / f"{_validate_operation_id(operation_id)}.cancel"


_SIGNAL_CANCELLED = False


def _request_signal_cancel(_signum: int, _frame: Any) -> None:
    global _SIGNAL_CANCELLED
    _SIGNAL_CANCELLED = True


def _process_token(pid: int) -> str:
    """Return Linux's process start-time token to make PID checks reuse-safe."""

    path = Path(f"/proc/{pid}/stat")
    fd = -1
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        payload = os.read(fd, 4097)
        if len(payload) > 4096:
            return ""
        tail = payload[payload.rfind(b")") + 2 :].split()
        return tail[19].decode("ascii") if len(tail) > 19 else ""
    except (OSError, UnicodeError):
        return ""
    finally:
        if fd >= 0:
            os.close(fd)


def _worker_alive(record: dict[str, Any]) -> bool:
    pid = record.get("workerPid")
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    expected = str(record.get("workerToken") or "")
    return not expected or secrets.compare_digest(_process_token(pid), expected)


class OperationControl:
    def __init__(self, operation_id: str):
        self.operation_id = _validate_operation_id(operation_id)
        self.deadline = time.monotonic() + MAX_OPERATION_SECONDS

    def check(self) -> None:
        if _SIGNAL_CANCELLED:
            raise OperationCancelled("cancelled", "Operation was cancelled")
        if time.monotonic() >= self.deadline:
            raise OperationCancelled("operation_timeout", "Operation exceeded its time limit")
        try:
            info = _cancel_path(self.operation_id).lstat()
        except FileNotFoundError:
            return
        except OSError as error:
            raise OperationCancelled("cancelled", f"Cancellation state is unavailable: {error}") from error
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise OperationCancelled("cancelled", "Operation cancellation was requested")
        raise OperationCancelled("cancelled", "Operation was cancelled")


@contextmanager
def _operation_lock(operation_id: str) -> Iterator[None]:
    directory = _state_directory()
    lock_path = directory / f"{_validate_operation_id(operation_id)}.lock"
    fd = os.open(
        lock_path,
        os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise RequestError("unsafe_journal", "Operation lock is unsafe")
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _write_journal(record: dict[str, Any]) -> None:
    operation_id = _validate_operation_id(record.get("operationId", ""))
    path = _journal_path(operation_id)
    payload = _json_bytes(record, journal=True) + b"\n"
    temporary = path.parent / f".{operation_id}.{secrets.token_hex(8)}.tmp"
    fd = -1
    try:
        fd = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        view = memoryview(payload)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _read_journal(operation_id: str) -> dict[str, Any]:
    path = _journal_path(operation_id)
    fd = -1
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise RequestError("unsafe_journal", "Operation journal is not a regular file")
        if info.st_uid != os.getuid() or info.st_size > MAX_JOURNAL_BYTES:
            raise RequestError("unsafe_journal", "Operation journal failed validation")
        chunks: list[bytes] = []
        remaining = MAX_JOURNAL_BYTES + 1
        while remaining:
            block = os.read(fd, min(8192, remaining))
            if not block:
                break
            chunks.append(block)
            remaining -= len(block)
        payload = b"".join(chunks)
        if len(payload) > MAX_JOURNAL_BYTES:
            raise RequestError("unsafe_journal", "Operation journal failed validation")
        record = json.loads(payload)
    except FileNotFoundError as error:
        raise RequestError("operation_not_found", "Operation was not found") from error
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RequestError("invalid_journal", "Operation journal is corrupt") from error
    finally:
        if fd >= 0:
            os.close(fd)
    if not isinstance(record, dict) or record.get("operationId") != operation_id:
        raise RequestError("invalid_journal", "Operation journal identity does not match")
    return record


def _create_record(record: dict[str, Any]) -> None:
    operation_id = _validate_operation_id(record.get("operationId", ""))
    with _operation_lock(operation_id):
        if os.path.lexists(_journal_path(operation_id)) or os.path.lexists(
            _cancel_path(operation_id)
        ):
            raise RequestError("operation_id_in_use", "Operation ID is already in use")
        _write_journal(record)


def _save_record(record: dict[str, Any]) -> None:
    operation_id = _validate_operation_id(record.get("operationId", ""))
    with _operation_lock(operation_id):
        try:
            current = _read_journal(operation_id)
            if current.get("cancelRequested"):
                record["cancelRequested"] = True
                if current.get("state") == "cancelling" and record.get("state") == "running":
                    record["state"] = "cancelling"
        except RequestError as error:
            if error.code != "operation_not_found":
                raise
        _write_journal(record)


def _public_record(record: dict[str, Any], *, command: str | None = None) -> dict[str, Any]:
    public = {
        key: value
        for key, value in record.items()
        if key not in {"proofs", "workerPid", "workerToken"}
    }
    if command and command != record.get("command"):
        public["operationCommand"] = record.get("command")
        public["command"] = command
    return public


def _size_text(size: int) -> str:
    units = ("bytes", "KiB", "MiB", "GiB", "TiB")
    value = float(max(0, size))
    for index, unit in enumerate(units):
        if value < 1024 or index == len(units) - 1:
            if index == 0:
                return f"{int(value)} bytes"
            return f"{value:.1f} {unit}"
        value /= 1024
    return f"{size} bytes"


def inspect_item(raw: str) -> dict[str, Any]:
    path = local_path(raw)
    desktop = desktop_dir()
    try:
        if path.parent.resolve() != desktop:
            raise RequestError("outside_desktop", "Inspect is limited to direct Desktop items")
    except OSError as error:
        raise RequestError("invalid_path", f"Could not validate Desktop item: {error}") from error
    info = _lstat_supported(path)
    kind = "folder" if stat.S_ISDIR(info.st_mode) else "file"
    if stat.S_ISREG(info.st_mode) and path.suffix.lower() == ".desktop":
        kind = "launcher"
    mime_type = mimetypes.guess_type(path.name, strict=False)[0] or (
        "inode/directory" if kind == "folder" else "application/octet-stream"
    )
    preview_eligible = (
        kind == "file"
        and path.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
        and 0 < info.st_size <= 32 * 1024 * 1024
    )
    return {
        "schemaVersion": SCHEMA_VERSION,
        "command": "inspect",
        "ok": True,
        "state": "completed",
        "undoable": False,
        "item": {
            "path": str(path),
            "name": path.name,
            "location": str(path.parent),
            "kind": kind,
            "isDirectory": stat.S_ISDIR(info.st_mode),
            "size": info.st_size,
            "sizeText": "Not calculated" if kind == "folder" else _size_text(info.st_size),
            "modifiedUnixMs": info.st_mtime_ns // 1_000_000,
            "modifiedTime": datetime.fromtimestamp(
                info.st_mtime, timezone.utc
            ).isoformat(timespec="seconds"),
            "mimeType": mime_type,
            "mode": f"{stat.S_IMODE(info.st_mode):04o}",
            "ownerIsCurrentUser": info.st_uid == os.getuid(),
            "readable": os.access(path, os.R_OK),
            "writable": os.access(path, os.W_OK),
            "previewEligible": preview_eligible,
            "previewPolicy": "Local grayscale preview" if preview_eligible else "One-bit type icon",
            "launcherExecutable": kind == "launcher" and bool(info.st_mode & 0o111),
        },
    }


def _new_record(
    command: str,
    sources: list[str],
    destination: str | None = None,
    *,
    operation_id: str | None = None,
    state: str = "running",
) -> dict[str, Any]:
    operation_id = _validate_operation_id(operation_id) if operation_id else secrets.token_hex(16)
    now = _utc_now()
    record: dict[str, Any] = {
        "schemaVersion": SCHEMA_VERSION,
        "operationId": operation_id,
        "command": command,
        "ok": False,
        "state": state,
        "undoable": False,
        "cancellable": state in {"queued", "running", "cancelling"},
        "cancelRequested": False,
        "createdAt": now,
        "updatedAt": now,
        "sources": sources,
        "results": [
            {"source": source, "destination": None, "status": "pending"}
            for source in sources
        ],
        "proofs": [],
        "progress": {
            "total": len(sources),
            "processed": 0,
            "completed": 0,
            "failed": 0,
            "cancelled": 0,
            "pending": len(sources),
            "currentIndex": -1,
        },
    }
    if destination is not None:
        record["destination"] = destination
    return record


def reserve(command: str, source_count: int) -> dict[str, Any]:
    if command not in {"copy", "move", "trash", "rename"}:
        raise RequestError("invalid_operation", "Operation cannot be reserved")
    if source_count < 1 or source_count > MAX_SOURCES:
        raise RequestError(
            "invalid_source_count",
            f"Source count must be between 1 and {MAX_SOURCES}",
        )
    if command == "rename" and source_count != 1:
        raise RequestError("invalid_source_count", "Rename requires exactly one source")
    for _attempt in range(16):
        record = _new_record(command, [], state="queued")
        record["expectedSourceCount"] = source_count
        record["progress"]["total"] = source_count
        record["progress"]["pending"] = source_count
        try:
            _create_record(record)
            public = _public_record(record, command="reserve")
            public["ok"] = True
            public["reservationAccepted"] = True
            return public
        except RequestError as error:
            if error.code != "operation_id_in_use":
                raise
    raise RequestError("operation_id_unavailable", "Could not allocate an operation ID")


def _start_record(
    command: str,
    sources: list[str],
    destination: str | None,
    operation_id: str | None,
) -> dict[str, Any]:
    if operation_id is None:
        for _attempt in range(16):
            record = _new_record(command, sources, destination)
            record["workerPid"] = os.getpid()
            record["workerToken"] = _process_token(os.getpid())
            record["startedAt"] = _utc_now()
            try:
                _create_record(record)
                break
            except RequestError as error:
                if error.code != "operation_id_in_use":
                    raise
        else:
            raise RequestError("operation_id_unavailable", "Could not allocate an operation ID")
    else:
        operation_id = _validate_operation_id(operation_id)
        with _operation_lock(operation_id):
            path = _journal_path(operation_id)
            if os.path.lexists(path):
                record = _read_journal(operation_id)
                if record.get("state") != "queued":
                    raise RequestError("operation_id_in_use", "Operation ID is already in use")
                if record.get("command") != command:
                    raise RequestError("operation_mismatch", "Reserved operation does not match")
                if record.get("expectedSourceCount") != len(sources):
                    raise RequestError("operation_mismatch", "Reserved source count does not match")
                if record.get("cancelRequested"):
                    raise RequestError("operation_cancelled", "Reserved operation was cancelled")
                created_at = record.get("createdAt") or _utc_now()
                record = _new_record(
                    command,
                    sources,
                    destination,
                    operation_id=operation_id,
                )
                record["createdAt"] = created_at
            else:
                if os.path.lexists(_cancel_path(operation_id)):
                    raise RequestError("operation_id_in_use", "Operation ID is already in use")
                record = _new_record(
                    command,
                    sources,
                    destination,
                    operation_id=operation_id,
                )
            record["workerPid"] = os.getpid()
            record["workerToken"] = _process_token(os.getpid())
            record["startedAt"] = _utc_now()
            _write_journal(record)
        return record
    return record


def _update_progress(record: dict[str, Any], current_index: int = -1) -> None:
    statuses = [str(result.get("status") or "") for result in record.get("results", [])]
    completed = statuses.count("completed")
    failed = statuses.count("failed")
    cancelled = statuses.count("cancelled")
    processed = completed + failed + cancelled
    total = len(statuses)
    record["progress"] = {
        "total": total,
        "processed": processed,
        "completed": completed,
        "failed": failed,
        "cancelled": cancelled,
        "pending": max(0, total - processed),
        "currentIndex": current_index,
    }


def _finish_record(record: dict[str, Any]) -> None:
    _update_progress(record)
    progress = record["progress"]
    completed = progress["completed"]
    failed = progress["failed"]
    cancelled = progress["cancelled"]
    if completed and (failed or cancelled):
        record["state"] = "partial"
    elif completed and completed == progress["total"]:
        record["state"] = "completed"
    elif cancelled and not completed and not failed:
        record["state"] = "cancelled"
    else:
        record["state"] = "failed"
    record["ok"] = record["state"] == "completed"
    record["cancellable"] = False
    if failed or cancelled:
        first_failed = next(
            (
                result
                for result in record["results"]
                if result.get("status") in {"failed", "cancelled"}
            ),
            None,
        )
        if first_failed and first_failed.get("error"):
            record["error"] = first_failed["error"]
    record["updatedAt"] = _utc_now()


def _result_error(source: str, error: Exception, destination: str | None = None) -> dict[str, Any]:
    code = error.code if isinstance(error, (RequestError, ItemError)) else "filesystem_error"
    result: dict[str, Any] = {
        "source": source,
        "destination": destination,
        "status": "failed",
        "error": _error(code, error),
    }
    return result


def _result_cancelled(source: str, error: Exception) -> dict[str, Any]:
    return {
        "source": source,
        "destination": None,
        "status": "cancelled",
        "error": _error(getattr(error, "code", "cancelled"), error),
    }


def _save_progress(record: dict[str, Any], current_index: int = -1) -> None:
    _update_progress(record, current_index)
    record["updatedAt"] = _utc_now()
    _save_record(record)


def transfer(
    command: str,
    raw_sources: list[str],
    raw_destination: str,
    operation_id: str | None = None,
) -> tuple[dict[str, Any], int]:
    if len(raw_sources) > MAX_SOURCES:
        raise RequestError("too_many_sources", f"At most {MAX_SOURCES} sources are allowed")
    if not raw_sources:
        raise RequestError("no_sources", "At least one source is required")
    record = _start_record(command, raw_sources, raw_destination, operation_id)
    control = OperationControl(record["operationId"])
    try:
        destination = _validate_destination(raw_destination)
        record["destination"] = str(destination)
    except Exception as error:
        for index, raw in enumerate(raw_sources):
            record["results"][index] = _result_error(raw, error)
        _finish_record(record)
        _save_record(record)
        return _public_record(record), 1

    seen: set[str] = set()
    resolved_sources: list[Path] = []
    parsed: list[tuple[str, Path | None, Exception | None]] = []
    for raw in raw_sources:
        try:
            path = local_path(raw)
            canonical = str(path.resolve())
            if canonical in seen:
                raise ItemError("duplicate_source", f"Source appears more than once: {path.name}")
            seen.add(canonical)
            parsed.append((raw, path, None))
            resolved_sources.append(path.resolve())
        except Exception as error:
            parsed.append((raw, None, error))

    for index, (raw, source, parse_error) in enumerate(parsed):
        try:
            control.check()
        except OperationCancelled as error:
            for pending_index in range(index, len(raw_sources)):
                record["results"][pending_index] = _result_cancelled(
                    raw_sources[pending_index], error
                )
            break
        if parse_error is not None or source is None:
            record["results"][index] = _result_error(
                raw,
                parse_error or ItemError("invalid_path", "Invalid source"),
            )
            _save_progress(record)
            continue
        record["results"][index] = {
            "source": str(source),
            "destination": None,
            "status": "running",
        }
        _save_progress(record, index)
        try:
            _preflight_source(source, destination)
            resolved = source.resolve()
            if any(
                other != resolved and _is_relative_to(resolved, other)
                for other in resolved_sources
            ):
                raise ItemError("nested_source", f"Nested source is also selected: {source.name}")
            launcher_to_desktop = (
                source.suffix.lower() == ".desktop"
                and destination == desktop_dir()
            )
            if launcher_to_desktop:
                target = _launcher_to_desktop(
                    source,
                    destination,
                    move=command == "move",
                    control=control,
                )
            elif command == "copy":
                target = _copy_to_unique(source, destination, control)
            else:
                target = _move_to_unique(source, destination, control)
            record["results"][index] = {
                "source": str(source),
                "destination": str(target),
                "status": "completed",
            }
            if command == "move":
                proof = _move_proof(source, target)
                if proof is not None:
                    record["proofs"].append(proof)
        except OperationCancelled as error:
            record["results"][index] = _result_cancelled(str(source), error)
            for pending_index in range(index + 1, len(raw_sources)):
                record["results"][pending_index] = _result_cancelled(
                    raw_sources[pending_index], error
                )
            break
        except Exception as error:
            record["results"][index] = _result_error(str(source), error)
        _save_progress(record)

    _finish_record(record)
    completed = record["progress"]["completed"]
    record["undoable"] = (
        command == "move"
        and completed > 0
        and len(record["proofs"]) == completed
    )
    _save_record(record)
    return _public_record(record), 0 if record["ok"] else 1


def _stop_child(child: subprocess.Popen[Any]) -> None:
    try:
        if os.getpgid(child.pid) == child.pid:
            os.killpg(child.pid, signal.SIGTERM)
        else:
            child.terminate()
    except (ProcessLookupError, OSError):
        return
    try:
        child.wait(timeout=CHILD_CANCEL_GRACE_SECONDS)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        if os.getpgid(child.pid) == child.pid:
            os.killpg(child.pid, signal.SIGKILL)
        else:
            child.kill()
    except (ProcessLookupError, OSError):
        pass
    try:
        child.wait(timeout=CHILD_CANCEL_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        raise ItemError("child_cleanup_failed", "A helper process could not be stopped")


def _run_bounded_child(argv: list[str], control: OperationControl) -> None:
    child: subprocess.Popen[Any] | None = None
    deadline = time.monotonic() + CHILD_TIMEOUT_SECONDS
    try:
        child = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            preexec_fn=_kill_child_when_parent_dies if sys.platform.startswith("linux") else None,
        )
        while True:
            control.check()
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ItemError("child_timeout", "The local helper timed out")
            try:
                return_code = child.wait(timeout=min(0.1, remaining))
                break
            except subprocess.TimeoutExpired:
                continue
    except FileNotFoundError as error:
        raise ItemError("child_missing", "The local helper is unavailable") from error
    except (OperationCancelled, ItemError):
        if child is not None:
            _stop_child(child)
        raise
    except OSError as error:
        if child is not None:
            _stop_child(child)
        raise ItemError("child_failed", f"Could not start the local helper: {error}") from error
    if return_code != 0:
        raise ItemError("child_failed", f"The local helper exited with status {return_code}")


def _run_gio_trash(path: Path, control: OperationControl) -> None:
    try:
        _run_bounded_child(
            ["gio", "trash", str(path)],
            control,
        )
    except ItemError as error:
        if error.code == "child_missing":
            raise ItemError("child_missing", "The local Trash helper is unavailable") from error
        raise


def trash(
    raw_sources: list[str], operation_id: str | None = None
) -> tuple[dict[str, Any], int]:
    if len(raw_sources) > MAX_SOURCES:
        raise RequestError("too_many_sources", f"At most {MAX_SOURCES} sources are allowed")
    if not raw_sources:
        raise RequestError("no_sources", "At least one source is required")
    record = _start_record("trash", raw_sources, None, operation_id)
    control = OperationControl(record["operationId"])
    try:
        desktop = desktop_dir()
    except Exception as error:
        for index, raw in enumerate(raw_sources):
            record["results"][index] = _result_error(raw, error)
        _finish_record(record)
        _save_record(record)
        return _public_record(record), 1

    seen: set[str] = set()
    for index, raw in enumerate(raw_sources):
        try:
            control.check()
        except OperationCancelled as error:
            for pending_index in range(index, len(raw_sources)):
                record["results"][pending_index] = _result_cancelled(
                    raw_sources[pending_index], error
                )
            break
        record["results"][index] = {
            "source": raw,
            "destination": None,
            "status": "running",
        }
        _save_progress(record, index)
        try:
            path = local_path(raw)
            lexical_key = str(path)
            if lexical_key in seen:
                raise ItemError("duplicate_source", f"Source appears more than once: {path.name}")
            seen.add(lexical_key)
            if path.parent.resolve() != desktop:
                raise ItemError("outside_desktop", "Trash is limited to direct Desktop items")
            _lstat_supported(path, allow_symlink=True)
            _run_gio_trash(path, control)
            record["results"][index] = {
                "source": str(path),
                "destination": None,
                "status": "completed",
            }
        except OperationCancelled as error:
            record["results"][index] = _result_cancelled(raw, error)
            for pending_index in range(index + 1, len(raw_sources)):
                record["results"][pending_index] = _result_cancelled(
                    raw_sources[pending_index], error
                )
            break
        except Exception as error:
            record["results"][index] = _result_error(raw, error)
        _save_progress(record)
    _finish_record(record)
    record["undoable"] = False
    _save_record(record)
    return _public_record(record), 0 if record["ok"] else 1


def _validate_new_name(raw_name: str) -> str:
    name = str(raw_name or "")
    if not name or name in {".", ".."}:
        raise RequestError("invalid_name", "A new name is required")
    if name != name.strip():
        raise RequestError("invalid_name", "A name cannot start or end with whitespace")
    if "/" in name or "\x00" in name:
        raise RequestError("invalid_name", "A name cannot contain a path separator")
    if any(ord(character) < 32 or ord(character) == 127 for character in name):
        raise RequestError("invalid_name", "A name cannot contain control characters")
    if len(os.fsencode(name)) > MAX_NAME_BYTES:
        raise RequestError("name_too_long", f"Names are limited to {MAX_NAME_BYTES} bytes")
    return name


def rename_item(
    raw_source: str,
    raw_name: str,
    operation_id: str | None = None,
) -> tuple[dict[str, Any], int]:
    record = _start_record("rename", [raw_source], None, operation_id)
    control = OperationControl(record["operationId"])
    try:
        control.check()
        desktop = desktop_dir()
        source = local_path(raw_source)
        name = _validate_new_name(raw_name)
        if source.parent.resolve() != desktop:
            raise ItemError("outside_desktop", "Rename is limited to direct Desktop items")
        before = _lstat_supported(source)
        destination = source.parent / name
        if source.name == name:
            raise ItemError("same_name", "The item already has that name")
        if source.suffix.lower() != ".desktop" and destination.suffix.lower() == ".desktop":
            raise ItemError(
                "unsafe_launcher_name",
                "A non-launcher cannot be renamed into a Desktop launcher",
            )
        record["destination"] = str(destination)
        record["results"][0] = {
            "source": str(source),
            "destination": str(destination),
            "status": "running",
        }
        _save_progress(record, 0)
        _rename_noreplace(source, destination)
        after = destination.lstat()
        if os.path.lexists(source) or (before.st_dev, before.st_ino) != (
            after.st_dev,
            after.st_ino,
        ):
            raise ItemError("postcondition_failed", "Rename postcondition could not be proved")
        record["results"][0] = {
            "source": str(source),
            "destination": str(destination),
            "status": "completed",
        }
    except FileExistsError as error:
        record["results"][0] = _result_error(
            raw_source,
            ItemError("destination_exists", "An item with that name already exists"),
            record.get("destination"),
        )
    except OperationCancelled as error:
        record["results"][0] = _result_cancelled(raw_source, error)
    except Exception as error:
        record["results"][0] = _result_error(
            raw_source,
            error,
            record.get("destination"),
        )
    _finish_record(record)
    record["undoable"] = False
    _save_record(record)
    return _public_record(record), 0 if record["ok"] else 1


def _write_cancel_marker(operation_id: str) -> None:
    path = _cancel_path(operation_id)
    fd = -1
    try:
        fd = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        os.write(fd, b"cancel\n")
        os.fsync(fd)
    except FileExistsError:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise RequestError("unsafe_cancel_state", "Operation cancellation state is unsafe")
    finally:
        if fd >= 0:
            os.close(fd)


def cancel(operation_id: str) -> dict[str, Any]:
    operation_id = _validate_operation_id(operation_id)
    with _operation_lock(operation_id):
        record = _read_journal(operation_id)
        state = str(record.get("state") or "")
        if state not in {"queued", "running", "cancelling"}:
            raise RequestError("operation_finished", "Operation is no longer cancellable")
        _write_cancel_marker(operation_id)
        record["cancelRequested"] = True
        record["updatedAt"] = _utc_now()
        if state == "queued":
            total = int(record.get("expectedSourceCount") or 0)
            record["state"] = "cancelled"
            record["cancellable"] = False
            record["progress"] = {
                "total": total,
                "processed": total,
                "completed": 0,
                "failed": 0,
                "cancelled": total,
                "pending": 0,
                "currentIndex": -1,
            }
        else:
            record["state"] = "cancelling"
            record["cancellable"] = True
        _write_journal(record)
    public = _public_record(record, command="cancel")
    public["ok"] = True
    public["cancelAccepted"] = True
    return public


def _mark_interrupted(record: dict[str, Any]) -> None:
    error = ItemError("worker_lost", "Operation worker stopped before completion")
    for index, result in enumerate(record.get("results", [])):
        if result.get("status") in {"pending", "running"}:
            record["results"][index] = _result_error(
                str(result.get("source") or "item"), error
            )
    _finish_record(record)
    record["undoable"] = False


def status(operation_id: str) -> dict[str, Any]:
    operation_id = _validate_operation_id(operation_id)
    with _operation_lock(operation_id):
        record = _read_journal(operation_id)
        if record.get("state") in {"running", "cancelling"} and not _worker_alive(record):
            _mark_interrupted(record)
            _write_journal(record)
        if record.get("command") == "move" and record.get("undoable"):
            proofs = [proof for proof in record.get("proofs", []) if not proof.get("undone")]
            still_undoable = bool(proofs) and all(
                not os.path.lexists(local_path(proof["source"]))
                and _proof_metadata_matches(proof)
                for proof in proofs
            )
            if not still_undoable:
                record["undoable"] = False
                record["updatedAt"] = _utc_now()
                _write_journal(record)
    return _public_record(record, command="status")


def undo(operation_id: str) -> tuple[dict[str, Any], int]:
    operation_id = _validate_operation_id(operation_id)
    with _operation_lock(operation_id):
        record = _read_journal(operation_id)
        if record.get("command") != "move" or not record.get("undoable"):
            raise RequestError("not_undoable", "This operation does not have a safely provable Undo")
        proofs = [proof for proof in record.get("proofs", []) if not proof.get("undone")]
        if not proofs:
            raise RequestError("already_undone", "This operation has already been undone")

        # Prove the entire remaining batch before changing any path.
        for proof in proofs:
            source = local_path(proof["source"])
            if os.path.lexists(source):
                raise RequestError("undo_collision", f"Original path is occupied: {source}")
            if not _proof_matches(proof):
                raise RequestError("undo_proof_failed", f"Moved item changed after the operation: {proof['destination']}")

        undo_results: list[dict[str, Any]] = []
        for proof in proofs:
            destination = local_path(proof["destination"])
            source = local_path(proof["source"])
            try:
                _move_exact(destination, source)
                proof["undone"] = True
                undo_results.append(
                    {"source": str(destination), "destination": str(source), "status": "completed"}
                )
            except Exception as error:
                undo_results.append(_result_error(str(destination), error, str(source)))
                break

        remaining = [proof for proof in record.get("proofs", []) if not proof.get("undone")]
        failed = any(result["status"] == "failed" for result in undo_results)
        record["state"] = "undo-partial" if remaining or failed else "undone"
        record["ok"] = not remaining and not failed
        record["undoable"] = bool(remaining)
        record["updatedAt"] = _utc_now()
        record["undoResults"] = undo_results
        _write_journal(record)
        public = _public_record(record, command="undo")
    return public, 0 if public["ok"] else 1


def _parser() -> ReceiptParser:
    parser = ReceiptParser(description="One-Bit Bureau desktop operation helper")
    subparsers = parser.add_subparsers(dest="command", required=True)
    inspect_parser = subparsers.add_parser("inspect")
    inspect_parser.add_argument("path")
    reserve_parser = subparsers.add_parser("reserve")
    reserve_parser.add_argument("operation", choices=("copy", "move", "trash", "rename"))
    reserve_parser.add_argument("--source-count", required=True, type=int)
    for command in ("copy", "move"):
        operation_parser = subparsers.add_parser(command)
        operation_parser.add_argument("--operation-id")
        operation_parser.add_argument("--destination", required=True)
        operation_parser.add_argument("sources", nargs="+")
    trash_parser = subparsers.add_parser("trash")
    trash_parser.add_argument("--operation-id")
    trash_parser.add_argument("sources", nargs="+")
    rename_parser = subparsers.add_parser("rename")
    rename_parser.add_argument("--operation-id")
    rename_parser.add_argument("--name", required=True)
    rename_parser.add_argument("source")
    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("operation_id")
    cancel_parser = subparsers.add_parser("cancel")
    cancel_parser.add_argument("operation_id")
    undo_parser = subparsers.add_parser("undo")
    undo_parser.add_argument("operation_id")
    return parser


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    command_hint = raw_argv[0] if raw_argv else "unknown"
    try:
        _validate_raw_argv(raw_argv)
        args = _parser().parse_args(raw_argv)
        if args.command == "inspect":
            payload, exit_code = inspect_item(args.path), 0
        elif args.command == "reserve":
            payload, exit_code = reserve(args.operation, args.source_count), 0
        elif args.command in {"copy", "move"}:
            signal.signal(signal.SIGTERM, _request_signal_cancel)
            signal.signal(signal.SIGINT, _request_signal_cancel)
            payload, exit_code = transfer(
                args.command,
                args.sources,
                args.destination,
                args.operation_id,
            )
        elif args.command == "trash":
            signal.signal(signal.SIGTERM, _request_signal_cancel)
            signal.signal(signal.SIGINT, _request_signal_cancel)
            payload, exit_code = trash(args.sources, args.operation_id)
        elif args.command == "rename":
            signal.signal(signal.SIGTERM, _request_signal_cancel)
            signal.signal(signal.SIGINT, _request_signal_cancel)
            payload, exit_code = rename_item(
                args.source,
                args.name,
                args.operation_id,
            )
        elif args.command == "status":
            payload, exit_code = status(args.operation_id), 0
        elif args.command == "cancel":
            payload, exit_code = cancel(args.operation_id), 0
        elif args.command == "undo":
            payload, exit_code = undo(args.operation_id)
        else:
            raise RequestError("invalid_arguments", "Unknown command")
        emit(payload)
        return exit_code
    except Exception as error:
        try:
            emit(_failed_receipt(command_hint, error))
        except Exception:
            # Last-ditch bounded receipt; never echo raw arguments or paths.
            sys.stdout.write(
                '{"command":"unknown","error":{"code":"internal_error","message":"Could not encode result"},'
                '"ok":false,"schemaVersion":1,"state":"failed","undoable":false}\n'
            )
        return error.exit_code if isinstance(error, RequestError) else 1


if __name__ == "__main__":
    raise SystemExit(main())
