#!/usr/bin/python3
"""List, open, and place items on the Desktop for One-Bit Bureau."""

from __future__ import annotations

import argparse
import ctypes
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote, urlparse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

_BIN_DIR = str(Path(__file__).resolve().parent)
if _BIN_DIR not in sys.path:
    sys.path.insert(0, _BIN_DIR)

from common import desktop_dir, desktop_location, guess_icon, unique_dest
from desktop_policy import (
    is_trusted_application_launcher,
    is_under,
    lexical_path,
    trusted_application_dirs,
)

IMAGE_SUFFIXES = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".bmp",
    ".svg",
    ".avif",
    ".jxl",
}

# Raster-only: SVG/GIF can pull remote resources or do unbounded decode work.
SAFE_ICON_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
SAFE_PREVIEW_SUFFIXES = SAFE_ICON_SUFFIXES

MAX_ITEMS = 256
MAX_PATH_ARGS = 256
MAX_RAW_ARGS = 260
MAX_RAW_ARG_BYTES = 1024
MAX_OUTPUT_BYTES = 256 * 1024
MAX_NAME_LENGTH = 120
MAX_ID_LENGTH = 255
MAX_ICON_LENGTH = 4096
MAX_DESKTOP_FILE_BYTES = 64 * 1024
MAX_ICON_FILE_BYTES = 2 * 1024 * 1024
MAX_PREVIEW_FILE_BYTES = 32 * 1024 * 1024
MAX_ERROR_LENGTH = 240
MAX_PATH_BYTES = 1024
MAX_URI_BYTES = 4096
MAX_VOLUMES = 32
MAX_DEVICE_FIELD_LENGTH = 240
DEVICE_ACTION_TIMEOUT_SECONDS = 15
DEVICE_KILL_GRACE_SECONDS = 0.5
VIRTUAL_VOLUME_ID_RE = re.compile(r"^volume:[a-f0-9]{32}$")
PR_SET_PDEATHSIG = 1

ALLOWED_URL_SCHEMES = frozenset({"http", "https", "mailto", "file", "trash"})
THEME_ICON_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
HTML_TAG_RE = re.compile(r"<[^>]*>")
TRUSTED_METADATA_VALUES = frozenset({"true", "yes", "1"})
REMOTE_OR_INLINE_PREFIXES = (
    "http:",
    "https:",
    "ftp:",
    "ftps:",
    "sftp:",
    "smb:",
    "nfs:",
    "dav:",
    "data:",
    "qrc:",
    "image:",
    "qt:",
    "mailto:",
)


def plain_text(value: str, max_length: int = MAX_NAME_LENGTH) -> str:
    text = HTML_TAG_RE.sub(" ", str(value or "").replace("\x00", ""))
    cleaned = []
    for ch in text:
        code = ord(ch)
        if ch in "<>":
            cleaned.append(" ")
        elif ch == "\t" or (32 <= code < 127) or code > 127:
            cleaned.append(ch)
        else:
            cleaned.append(" ")
    return " ".join("".join(cleaned).split())[:max_length]


def bounded_field(value: object, max_bytes: int = MAX_DEVICE_FIELD_LENGTH) -> str:
    text = plain_text(str(value or ""), max_bytes)
    encoded = text.encode("utf-8", "replace")
    if len(encoded) <= max_bytes:
        return text
    return encoded[:max_bytes].decode("utf-8", "ignore").rstrip()


def _safe_call(obj, method: str, default=None, *args):
    try:
        function = getattr(obj, method)
        return function(*args)
    except Exception:
        return default


def trash_state() -> str:
    enumerator = None
    try:
        trash = Gio.File.new_for_uri("trash:///")
        enumerator = trash.enumerate_children(
            "standard::name",
            Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS,
            None,
        )
        return "full" if enumerator.next_file(None) is not None else "empty"
    except Exception:
        return "unknown"
    finally:
        if enumerator is not None:
            try:
                enumerator.close(None)
            except Exception:
                pass


def virtual_trash_item() -> dict:
    state = trash_state()
    return {
        "id": "virtual:trash",
        "virtualId": "trash",
        "virtual": True,
        "name": "Trash",
        "path": "",
        "icon": "user-trash-full" if state == "full" else "user-trash",
        "preview": "",
        "isDir": False,
        "kind": "trash",
        "trusted": True,
        "trashState": state,
        "canOpen": True,
        "canUnmount": False,
        "canEject": False,
    }


def _mount_identity(root_uri: str, uuid: str, device: str) -> str:
    material = "\x00".join((uuid, device, root_uri)).encode("utf-8", "strict")
    return "volume:" + hashlib.sha256(material).hexdigest()[:32]


def mounted_volume_records() -> list[dict]:
    try:
        monitor_type = getattr(Gio, "VolumeMonitor")
        monitor = monitor_type.get()
        mounts = list(monitor.get_mounts() or [])[: MAX_VOLUMES + 1]
    except Exception:
        return []

    records: list[dict] = []
    seen: set[str] = set()
    for mount in mounts:
        if len(records) >= MAX_VOLUMES:
            break
        if _safe_call(mount, "is_shadowed", False):
            continue
        root = _safe_call(mount, "get_root")
        root_path = _safe_call(root, "get_path", "") if root is not None else ""
        root_uri = _safe_call(root, "get_uri", "") if root is not None else ""
        if not root_path or not root_uri or not str(root_uri).startswith("file://"):
            continue
        if len(str(root_uri).encode("utf-8", "replace")) > MAX_URI_BYTES:
            continue
        root_path = os.path.abspath(str(root_path))
        if root_path == "/" or root_path.startswith("//"):
            continue
        if len(os.fsencode(root_path)) > MAX_PATH_BYTES:
            continue
        volume = _safe_call(mount, "get_volume")
        if volume is None:
            continue
        uuid = bounded_field(
            _safe_call(volume, "get_uuid", "") or _safe_call(mount, "get_uuid", "")
        )
        device = bounded_field(_safe_call(volume, "get_identifier", "", "unix-device"))
        virtual_id = _mount_identity(str(root_uri), uuid, device)
        if virtual_id in seen:
            continue
        seen.add(virtual_id)
        name = bounded_field(_safe_call(mount, "get_name", "Volume")) or "Volume"
        icon_object = _safe_call(mount, "get_icon")
        icon = sanitize_icon(_safe_call(icon_object, "to_string", "drive-removable-media"))
        can_unmount = bool(_safe_call(mount, "can_unmount", False))
        can_eject = bool(
            _safe_call(mount, "can_eject", False)
            or _safe_call(volume, "can_eject", False)
        )
        records.append(
            {
                "id": "virtual:" + virtual_id,
                "virtualId": virtual_id,
                "virtual": True,
                "name": name,
                "path": root_path,
                "mountPath": root_path,
                "icon": icon or "drive-removable-media",
                "preview": "",
                "isDir": True,
                "kind": "volume",
                "trusted": True,
                "device": device,
                "uuid": uuid,
                "canOpen": True,
                "canUnmount": can_unmount,
                "canEject": can_eject,
                "_uri": str(root_uri),
            }
        )
    records.sort(key=lambda record: (record["name"].casefold(), record["virtualId"]))
    return records


def virtual_items() -> list[dict]:
    items = [virtual_trash_item()]
    for record in mounted_volume_records():
        items.append({key: value for key, value in record.items() if not key.startswith("_")})
    return items


def _file_size(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


def allowed_icon_roots() -> list[Path]:
    roots = [
        Path.home(),
        desktop_dir(),
        Path("/usr/share/icons"),
        Path("/usr/share/pixmaps"),
        Path("/usr/local/share/icons"),
        Path("/usr/local/share/pixmaps"),
    ]
    for raw in os.environ.get("XDG_DATA_DIRS", "").split(":"):
        if raw.strip():
            roots.append(Path(raw) / "icons")
            roots.append(Path(raw) / "pixmaps")
    return roots


def is_allowed_local_image(path: Path, max_bytes: int, suffixes: set[str]) -> bool:
    try:
        resolved = path.expanduser().resolve()
    except OSError:
        return False
    text = str(resolved)
    if not text.startswith("/") or text.startswith("//"):
        return False
    if not resolved.is_file():
        return False
    if resolved.suffix.lower() not in suffixes:
        return False
    try:
        info = resolved.stat()
    except OSError:
        return False
    if not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or info.st_size > max_bytes:
        return False
    return any(is_under(resolved, root) for root in allowed_icon_roots())


def sanitize_icon_path(path: Path) -> str:
    if is_allowed_local_image(path, MAX_ICON_FILE_BYTES, SAFE_ICON_SUFFIXES):
        return str(path.expanduser().resolve())
    return ""


def sanitize_icon(raw: str) -> str:
    icon = str(raw or "").strip()
    if not icon or len(icon) > MAX_ICON_LENGTH:
        return ""
    lower = icon.lower()
    if lower.startswith("file:"):
        parsed = urlparse(icon)
        if parsed.scheme.lower() != "file":
            return ""
        if parsed.netloc and parsed.netloc.lower() not in {"", "localhost"}:
            return ""
        return sanitize_icon_path(Path(unquote(parsed.path)))
    if any(lower.startswith(prefix) for prefix in REMOTE_OR_INLINE_PREFIXES):
        return ""
    if "://" in icon or icon.startswith("//"):
        return ""
    if icon.startswith("/") or icon.startswith("~"):
        return sanitize_icon_path(Path(os.path.expanduser(icon)))
    if "/" in icon or "\\" in icon or ":" in icon:
        return ""
    if THEME_ICON_RE.fullmatch(icon):
        return icon
    return ""


def allowed_url(url: str) -> bool:
    text = str(url or "").strip()
    if not text or len(text) > 2048:
        return False
    parsed = urlparse(text)
    scheme = (parsed.scheme or "").lower()
    if scheme not in ALLOWED_URL_SCHEMES:
        return False
    if scheme == "file":
        if parsed.netloc and parsed.netloc.lower() not in {"", "localhost"}:
            return False
        path = unquote(parsed.path)
        return bool(path.startswith("/") and not path.startswith("//"))
    if scheme in {"http", "https"}:
        return bool(parsed.netloc) and "@" not in parsed.netloc
    if scheme == "mailto":
        return bool(parsed.path) and "://" not in parsed.path
    if scheme == "trash":
        return True
    return False


def read_desktop_entry(path: Path) -> dict[str, str]:
    try:
        if _file_size(path) > MAX_DESKTOP_FILE_BYTES:
            return {}
        keyfile = GLib.KeyFile()
        keyfile.load_from_file(str(path), GLib.KeyFileFlags.NONE)
        data = {}
        for key in ("Name", "Icon", "Type", "URL", "Exec"):
            try:
                data[key] = keyfile.get_string("Desktop Entry", key)
            except GLib.Error:
                pass
        return data
    except GLib.Error:
        return {}


def desktop_trusted_metadata(path: Path) -> bool | None:
    try:
        gfile = Gio.File.new_for_path(str(path))
        info = gfile.query_info(
            "metadata::trusted", Gio.FileQueryInfoFlags.NONE, None
        )
        value = (info.get_attribute_as_string("metadata::trusted") or "").strip().lower()
        if not value:
            return None
        if value in TRUSTED_METADATA_VALUES:
            return True
        return False
    except GLib.Error:
        return None


def is_trusted_desktop(path: Path) -> bool:
    try:
        resolved = path.expanduser().resolve()
    except OSError:
        return False
    if not resolved.is_file():
        return False
    for directory in trusted_application_dirs():
        if is_under(resolved, directory):
            return True
    try:
        st = path.lstat()
    except OSError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        return False
    if st.st_uid != os.getuid():
        return False
    if st.st_mode & 0o111:
        return True
    return desktop_trusted_metadata(path) is True


def mark_trusted(path: Path) -> None:
    path = path.expanduser()
    if not path.exists():
        raise FileNotFoundError(f"Path not found: {path}")
    try:
        st = path.lstat()
    except OSError as error:
        raise FileNotFoundError(f"Path not found: {path}") from error
    if stat.S_ISLNK(st.st_mode):
        raise PermissionError("Refusing to trust a symlink launcher")
    if not stat.S_ISREG(st.st_mode):
        raise PermissionError("Refusing to trust a non-file launcher")
    if st.st_uid != os.getuid():
        raise PermissionError("Refusing to trust a launcher owned by another user")
    path.chmod(st.st_mode | 0o111, follow_symlinks=False)
    gfile = Gio.File.new_for_path(str(path.resolve()))
    info = Gio.FileInfo.new()
    info.set_attribute_string("metadata::trusted", "true")
    try:
        gfile.set_attributes_from_info(info, Gio.FileQueryInfoFlags.NONE, None)
    except GLib.Error:
        result = subprocess.run(
            ["gio", "set", str(path), "metadata::trusted", "true"],
            check=False,
            capture_output=True,
        )
        if result.returncode != 0:
            raise PermissionError(f"Could not mark launcher trusted: {path.name}")
    if not is_trusted_desktop(path):
        raise PermissionError(f"Could not mark launcher trusted: {path.name}")


def is_trash_launcher(entry: dict[str, str]) -> bool:
    url = (entry.get("URL") or "").strip().lower()
    exec_line = (entry.get("Exec") or "").strip().lower()
    icon = (entry.get("Icon") or "").strip().lower()
    name = (entry.get("Name") or "").strip().lower()
    if url.startswith("trash:"):
        return True
    if "trash:///" in exec_line or exec_line.endswith(" trash"):
        return True
    if icon in {"user-trash", "user-trash-full", "application-x-trash"}:
        return True
    return name in {"trash", "wastebasket", "recycle bin"}


def item_for(path: Path) -> dict:
    name = plain_text(path.name)
    icon = sanitize_icon(guess_icon(path)) or (
        "folder" if path.is_dir() else "text-x-generic"
    )
    preview = ""
    kind = "folder" if path.is_dir() else "file"
    suffix = path.suffix.lower()
    trusted = True
    try:
        modified_unix_ms = path.lstat().st_mtime_ns // 1_000_000
    except OSError:
        modified_unix_ms = 0

    if suffix == ".desktop":
        entry = read_desktop_entry(path)
        kind = "trash" if is_trash_launcher(entry) else "launcher"
        trusted = kind == "trash" or is_trusted_desktop(path)
        name = plain_text(entry.get("Name") or path.stem)
        fallback = "user-trash" if kind == "trash" else "application-x-executable"
        icon = sanitize_icon(entry.get("Icon") or "") or fallback
    elif suffix == ".url":
        name = plain_text(path.stem)
        icon = "text-html"
        kind = "link"
    elif suffix in IMAGE_SUFFIXES:
        kind = "image"
        if is_allowed_local_image(
            path, MAX_PREVIEW_FILE_BYTES, SAFE_PREVIEW_SUFFIXES
        ):
            preview = str(path.expanduser().resolve())

    return {
        "id": path.name[:MAX_ID_LENGTH],
        "name": name or "Item",
        "path": str(path),
        "icon": icon,
        "preview": preview,
        "isDir": path.is_dir(),
        "kind": kind,
        "trusted": trusted,
        "modifiedUnixMs": modified_unix_ms,
    }


def encode_payload(payload: dict) -> str:
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))


def list_items() -> dict:
    location = desktop_location()
    items: list[dict] = virtual_items()
    truncated = False
    payload: dict = {
        "desktopEnabled": location.enabled,
        "desktopState": location.state,
        "desktopReason": bounded_field(location.reason, MAX_ERROR_LENGTH),
        "desktop": str(location.path) if location.enabled and location.path else "",
        "items": items,
    }
    if not location.enabled or location.path is None:
        return payload
    desktop = location.path
    try:
        entries = sorted(
            desktop.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower())
        )
    except OSError as error:
        payload["error"] = plain_text(str(error), MAX_ERROR_LENGTH)
        return payload

    for path in entries:
        if path.name.startswith("."):
            continue
        if len(items) >= MAX_ITEMS:
            truncated = True
            break
        item = item_for(path)
        # A deterministic virtual Trash replaces launcher-file heuristics and
        # avoids duplicate Trash nouns when an older setup left one behind.
        if item.get("kind") == "trash":
            continue
        items.append(item)

    if truncated:
        payload["truncated"] = True

    encoded = encode_payload(payload)
    while len(encoded.encode("utf-8")) > MAX_OUTPUT_BYTES and items:
        items.pop()
        payload["items"] = items
        payload["truncated"] = True
        encoded = encode_payload(payload)
    return payload


def path_from_uri(value: str) -> Path:
    return lexical_path(value)


def open_trash() -> None:
    nautilus = shutil.which("nautilus") or "/usr/bin/nautilus"
    Gio.Subprocess.new(
        [nautilus, "--new-window", "trash:///"],
        Gio.SubprocessFlags.NONE,
    )


class VirtualActionError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code


def _device_child_preexec() -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
        os._exit(127)
    if os.getppid() == 1:
        os._exit(127)


def _stop_device_child(child: subprocess.Popen) -> None:
    try:
        if os.getpgid(child.pid) == child.pid:
            os.killpg(child.pid, signal.SIGTERM)
        else:
            child.terminate()
    except (ProcessLookupError, OSError):
        return
    try:
        child.wait(timeout=DEVICE_KILL_GRACE_SECONDS)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        if os.getpgid(child.pid) == child.pid:
            os.killpg(child.pid, signal.SIGKILL)
        else:
            child.kill()
    except (ProcessLookupError, OSError):
        pass
    try:
        child.wait(timeout=DEVICE_KILL_GRACE_SECONDS)
    except subprocess.TimeoutExpired as error:
        raise VirtualActionError("helper_cleanup_failed", "Device helper could not be stopped") from error


def _run_device_command(argv: list[str]) -> None:
    child = None
    try:
        child = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            preexec_fn=_device_child_preexec if sys.platform.startswith("linux") else None,
        )
        return_code = child.wait(timeout=DEVICE_ACTION_TIMEOUT_SECONDS)
    except FileNotFoundError as error:
        raise VirtualActionError("helper_missing", "The local desktop helper is unavailable") from error
    except subprocess.TimeoutExpired as error:
        if child is not None:
            _stop_device_child(child)
        raise VirtualActionError("helper_timeout", "Device action timed out") from error
    except OSError as error:
        if child is not None:
            _stop_device_child(child)
        raise VirtualActionError("helper_failed", "Device action could not be started") from error
    if return_code != 0:
        raise VirtualActionError(
            "helper_failed",
            f"Device helper exited with status {return_code}",
        )


def _launch_files_window(uri: str) -> None:
    # GUI applications outlive this request helper. UWSM service mode hands
    # the fixed command to the user manager while preserving immediate launch
    # failures; unmount/eject commands stay on the stricter path above.
    _run_device_command(
        [
            "/usr/bin/uwsm",
            "app",
            "-t",
            "service",
            "--",
            "/usr/bin/nautilus",
            "--new-window",
            uri,
        ]
    )


def perform_virtual_action(action: str, virtual_id: str) -> tuple[dict, int]:
    canonical_id = str(virtual_id or "")
    if canonical_id == "virtual:trash":
        canonical_id = "trash"
    elif canonical_id.startswith("virtual:volume:"):
        canonical_id = canonical_id[len("virtual:") :]
    payload = {
        "schemaVersion": 1,
        "command": "virtual-action",
        "action": action,
        "virtualId": canonical_id,
        "ok": False,
        "state": "failed",
    }
    try:
        if action not in {"open", "unmount", "eject"}:
            raise VirtualActionError("invalid_action", "Unsupported virtual object action")
        if canonical_id == "trash":
            if action != "open":
                raise VirtualActionError("unsupported_action", "Trash cannot be unmounted or ejected")
            _launch_files_window("trash:///")
            payload.update(ok=True, state="requested", name="Trash")
            return payload, 0
        if not VIRTUAL_VOLUME_ID_RE.fullmatch(canonical_id):
            raise VirtualActionError("invalid_virtual_id", "Virtual object ID is invalid")
        record = next(
            (
                candidate
                for candidate in mounted_volume_records()
                if candidate.get("virtualId") == canonical_id
            ),
            None,
        )
        if record is None:
            raise VirtualActionError("volume_not_found", "The mounted volume is no longer available")
        if action == "open":
            _launch_files_window(record["_uri"])
            payload.update(ok=True, state="requested", name=record["name"])
            return payload, 0
        capability = "canUnmount" if action == "unmount" else "canEject"
        if record.get(capability) is not True:
            raise VirtualActionError(
                "unsupported_action",
                f"This volume does not support {action}",
            )
        option = "--unmount" if action == "unmount" else "--eject"
        _run_device_command(["/usr/bin/gio", "mount", option, record["_uri"]])
        if any(
            candidate.get("virtualId") == canonical_id
            for candidate in mounted_volume_records()
        ):
            raise VirtualActionError(
                "postcondition_failed",
                f"The volume is still mounted after {action}",
            )
        payload.update(ok=True, state="completed", name=record["name"])
        return payload, 0
    except VirtualActionError as error:
        payload["error"] = {
            "code": error.code,
            "message": bounded_field(error, MAX_ERROR_LENGTH),
        }
        return payload, 1


def trash_one(path: Path) -> None:
    path = lexical_path(str(path))
    if path.parent.resolve() != desktop_dir().resolve():
        raise PermissionError("Trash is limited to direct Desktop items")
    try:
        info = path.lstat()
    except OSError as error:
        raise FileNotFoundError(f"Path not found: {path}") from error
    if (
        stat.S_ISREG(info.st_mode)
        and path.suffix.lower() == ".desktop"
        and is_trash_launcher(read_desktop_entry(path))
    ):
        return
    # Gio must receive the lexical Desktop entry. Resolving here would move a
    # symlink's target to Trash and leave the broken link behind.
    gfile = Gio.File.new_for_path(str(path))
    try:
        gfile.trash(None)
    except GLib.Error as error:
        raise RuntimeError(f"Could not move to Trash: {error.message}") from error


def sanitize_link_url(url: str) -> str:
    url = (url or "").strip()
    if not url:
        raise ValueError("Shortcut has no URL")
    if url.startswith("/") or url.startswith("~"):
        url = Path(os.path.expanduser(url)).resolve().as_uri()
    if not allowed_url(url):
        parsed = urlparse(url)
        scheme = (parsed.scheme or "").lower() or "none"
        raise ValueError(f"Shortcut URL scheme not allowed: {scheme}")
    return url


def open_path(path: Path, *, require_trust: bool = True) -> None:
    path = path.expanduser()
    if not path.exists():
        raise FileNotFoundError(f"Path not found: {path}")

    suffix = path.suffix.lower()
    if suffix == ".url":
        helper = shutil.which("create-hyperlink") or str(
            Path.home() / ".local/bin/create-hyperlink"
        )
        Gio.Subprocess.new([helper, "--open", str(path)], Gio.SubprocessFlags.NONE)
        return

    if suffix == ".desktop":
        entry = read_desktop_entry(path)
        if is_trash_launcher(entry):
            open_trash()
            return
        if require_trust and not is_trusted_desktop(path):
            raise PermissionError(
                f"{path.name} is not a trusted launcher. "
                "Pin it from Applications, or allow launching from the desktop."
            )
        entry_type = (entry.get("Type") or "Application").strip()
        if entry_type.lower() == "link":
            url = sanitize_link_url(entry.get("URL") or "")
            Gio.AppInfo.launch_default_for_uri(url, None)
            return
        info = Gio.DesktopAppInfo.new_from_filename(str(path))
        if info is None:
            raise ValueError(f"Could not launch {path.name}")
        info.launch([], None)
        return

    Gio.AppInfo.launch_default_for_uri(path.resolve().as_uri(), None)


def place_one(source: Path, desktop: Path, mode: str) -> Path:
    source = lexical_path(str(source))
    try:
        source.lstat()
    except OSError as error:
        raise FileNotFoundError(f"Path not found: {source}") from error
    if mode == "move":
        user_home = Path.home().resolve()
        if source == user_home or not is_under(source.parent, user_home):
            raise PermissionError("Move is limited to items inside the home directory")
    else:
        source = source.resolve()
        if not source.exists():
            raise FileNotFoundError(f"Path not found: {source}")
    if source == desktop:
        raise ValueError("Cannot place the Desktop folder onto itself")
    if source.parent == desktop and mode != "link":
        return source

    launcher_transfer = mode in ("copy", "move") and source.suffix.lower() == ".desktop"
    if mode == "link" or launcher_transfer:
        helper = (
            shutil.which("add-to-desktop")
            or str(Path(__file__).resolve().parent / "add-to-desktop")
            or str(Path.home() / ".local/bin/add-to-desktop")
        )
        result = subprocess.run(
            [helper, str(source)],
            check=False,
            stdout=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError("Could not add the item to the Desktop safely")
        out = [line.strip() for line in (result.stdout or "").splitlines() if line.strip()]
        destination = lexical_path(out[-1] if out else str(desktop / source.name))
        if destination.parent.resolve() != desktop.resolve():
            raise RuntimeError("Safe Desktop helper returned an invalid destination")
        try:
            destination.lstat()
        except OSError as error:
            raise RuntimeError("Safe Desktop helper did not create the item") from error
        if mode == "move":
            source.unlink()
        return destination

    dest = unique_dest(desktop, source.name)
    if mode == "move":
        shutil.move(str(source), str(dest))
        return dest
    if source.is_dir():
        shutil.copytree(source, dest, dirs_exist_ok=False)
    else:
        shutil.copy2(source, dest)
    return dest


def _bounded_paths(values: list[str], flag: str) -> list[str]:
    if len(values) > MAX_PATH_ARGS:
        raise ValueError(f"Too many {flag} arguments (max {MAX_PATH_ARGS})")
    if any(not str(value or "").strip() for value in values):
        raise ValueError(f"Empty {flag} path")
    return values


def _validate_raw_argv(values: list[str]) -> None:
    if len(values) > MAX_RAW_ARGS:
        raise ValueError(f"Too many arguments (max {MAX_RAW_ARGS})")
    for value in values:
        if "\x00" in value or any(ord(character) < 32 or ord(character) == 127 for character in value):
            raise ValueError("Arguments cannot contain control characters")
        if len(value.encode("utf-8", "surrogateescape")) > MAX_RAW_ARG_BYTES:
            raise ValueError(f"Each argument is limited to {MAX_RAW_ARG_BYTES} bytes")


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    _validate_raw_argv(raw_argv)
    parser = argparse.ArgumentParser(description="Desktop icon helper")
    parser.add_argument("--open", nargs="+", metavar="PATH", help="Open desktop items")
    parser.add_argument(
        "--trust",
        nargs="+",
        metavar="PATH",
        help="Mark .desktop launchers as trusted",
    )
    parser.add_argument(
        "--trust-and-open",
        nargs="+",
        metavar="PATH",
        help="Mark .desktop launchers as trusted and open them",
    )
    parser.add_argument(
        "--trash",
        nargs="+",
        metavar="PATH",
        help="Move files to the Trash",
    )
    parser.add_argument(
        "--place",
        nargs="+",
        metavar="PATH",
        help="Copy, move, or pin files onto the Desktop",
    )
    parser.add_argument(
        "--mode",
        choices=("copy", "move", "link"),
        default="copy",
        help="How --place should add items (default: copy)",
    )
    parser.add_argument(
        "--virtual-action",
        choices=("open", "unmount", "eject"),
        help="Act on a deterministic virtual Trash or volume object.",
    )
    parser.add_argument("--virtual-id", help="Virtual object identity from the index.")
    args = parser.parse_args(raw_argv)

    if args.virtual_action:
        if not args.virtual_id:
            payload = {
                "schemaVersion": 1,
                "command": "virtual-action",
                "action": args.virtual_action,
                "virtualId": "",
                "ok": False,
                "state": "failed",
                "error": {
                    "code": "invalid_virtual_id",
                    "message": "A virtual object ID is required",
                },
            }
            sys.stdout.write(encode_payload(payload) + "\n")
            return 2
        payload, exit_code = perform_virtual_action(args.virtual_action, args.virtual_id)
        sys.stdout.write(encode_payload(payload) + "\n")
        return exit_code

    if args.trust_and_open:
        for raw in _bounded_paths(args.trust_and_open, "--trust-and-open"):
            target = Path(raw)
            mark_trusted(target)
            open_path(target, require_trust=True)
        return 0

    if args.trust:
        for raw in _bounded_paths(args.trust, "--trust"):
            mark_trusted(Path(raw))
        return 0

    if args.open:
        for raw in _bounded_paths(args.open, "--open"):
            open_path(Path(raw))
        return 0

    if args.trash:
        for raw in _bounded_paths(args.trash, "--trash"):
            trash_one(path_from_uri(raw))
        return 0

    if args.place:
        desktop = desktop_dir()
        for raw in _bounded_paths(args.place, "--place"):
            place_one(path_from_uri(raw), desktop, args.mode)
        return 0

    payload = list_items()
    sys.stdout.write(encode_payload(payload))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        if "--virtual-action" in sys.argv:
            json.dump(
                {
                    "schemaVersion": 1,
                    "command": "virtual-action",
                    "ok": False,
                    "state": "failed",
                    "error": {
                        "code": "invalid_arguments",
                        "message": plain_text(str(error), MAX_ERROR_LENGTH),
                    },
                },
                sys.stdout,
            )
            sys.stdout.write("\n")
            raise SystemExit(2)
        mutating = any(
            flag in sys.argv
            for flag in ("--open", "--place", "--trash", "--trust", "--trust-and-open")
        )
        if mutating:
            try:
                Gio.Subprocess.new(
                    [
                        "omarchy-notification-send",
                        "-u",
                        "normal",
                        "Desktop",
                        plain_text(str(error), MAX_ERROR_LENGTH),
                    ],
                    Gio.SubprocessFlags.NONE,
                )
            except Exception:
                print(error, file=sys.stderr)
            raise SystemExit(1)
        json.dump(
            {
                "desktopEnabled": False,
                "desktopState": "unavailable",
                "desktop": "",
                "items": [],
                "error": plain_text(str(error), MAX_ERROR_LENGTH),
            },
            sys.stdout,
        )
        sys.stdout.write("\n")
        raise SystemExit(1)
