#!/bin/bash

set -euo pipefail

PLUGIN_ID="io.github.regionallyfamous.one-bit-bureau"
PRODUCT_NAME="One-Bit Bureau"
THEME_NAME="one-bit-bureau"
EXPECTED_REPO_URL="https://github.com/RegionallyFamous/one-bit-bureau.git"
STATE_DIR="$HOME/.local/state/omarchy/plugins/$PLUGIN_ID"
STATE_FILE="$STATE_DIR/install-state.json"
SHELL_CONFIG="$HOME/.config/omarchy/shell.json"
THEME_STATE="$HOME/.local/state/omarchy/current/theme.name"
PLUGIN_TARGET="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
THEME_TARGET="$HOME/.config/omarchy/themes/$THEME_NAME"
THEME_SOURCES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/theme-sources"
FONT_TARGET="$HOME/.local/share/fonts/one-bit-bureau"
BRANDING_TARGET="$HOME/.config/omarchy/branding"
BRANDING_BACKUP_DIR="$STATE_DIR/backups/branding"
COMMAND_TARGET="$HOME/.local/bin/one-bit-bureau"
BRANDING_MAX_BYTES=$((1024 * 1024))
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SECURE_IO_SOURCE="$SCRIPT_DIR/scripts/one_bit_bureau_secure_io.py"
if [[ ! -f $SECURE_IO_SOURCE || -L $SECURE_IO_SOURCE ]]; then
  SECURE_IO_SOURCE="$PLUGIN_TARGET/scripts/one_bit_bureau_secure_io.py"
fi
SECURE_IO_TEMP_DIR=""

cleanup_uninstall_files() {
  [[ -z $SECURE_IO_TEMP_DIR || ! -e $SECURE_IO_TEMP_DIR ]] || rm -rf -- "$SECURE_IO_TEMP_DIR"
  if [[ -n ${ONE_BIT_BUREAU_UNINSTALL_TEMP:-} && $ONE_BIT_BUREAU_UNINSTALL_TEMP == "${BASH_SOURCE[0]}" ]]; then
    rm -f -- "$ONE_BIT_BUREAU_UNINSTALL_TEMP"
  fi
}
trap cleanup_uninstall_files EXIT

command -v omarchy >/dev/null || {
  echo "Omarchy is unavailable; no changes were made." >&2
  exit 1
}
command -v jq >/dev/null || {
  echo "jq is unavailable; no changes were made." >&2
  exit 1
}
command -v fc-cache >/dev/null || {
  echo "fontconfig is unavailable; no changes were made." >&2
  exit 1
}
command -v python3 >/dev/null || {
  echo "Python 3 is unavailable; no changes were made." >&2
  exit 1
}
[[ -f $SECURE_IO_SOURCE && ! -L $SECURE_IO_SOURCE ]] || {
  echo "$PRODUCT_NAME secure transaction helper is missing or unsafe; no changes were made." >&2
  exit 1
}
SECURE_IO_TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/one-bit-bureau-secure-io.XXXXXX")
cp -- "$SECURE_IO_SOURCE" "$SECURE_IO_TEMP_DIR/one_bit_bureau_secure_io.py"
chmod 600 "$SECURE_IO_TEMP_DIR/one_bit_bureau_secure_io.py"
SECURE_IO="$SECURE_IO_TEMP_DIR/one_bit_bureau_secure_io.py"
state_snapshot=$(python3 "$SECURE_IO" install-state snapshot) || {
  echo "$PRODUCT_NAME has no ownership record at $STATE_FILE; refusing to remove unowned files." >&2
  exit 1
}
state_json=$(jq -ce '.record' <<<"$state_snapshot") || {
  echo "$PRODUCT_NAME ownership snapshot is invalid; no changes were made." >&2
  exit 1
}
state_record_hash=$(jq -er '.recordHash | select(test("^[a-f0-9]{64}$"))' <<<"$state_snapshot") || {
  echo "$PRODUCT_NAME ownership snapshot hash is invalid; no changes were made." >&2
  exit 1
}

jq -e --arg id "$PLUGIN_ID" --arg product "$PRODUCT_NAME" --arg theme "$THEME_NAME" --arg repo "$EXPECTED_REPO_URL" '
  .schemaVersion == 3 and
  .pluginId == $id and
  .product == $product and
  .theme == $theme and
  (.pluginOwned | type == "boolean") and
  (.themeOwned | type == "boolean") and
  (.fontOwned | type == "boolean") and
  (.brandingOwned | type == "boolean") and
  (.commandOwned | type == "boolean") and
  (.installed | type == "object") and
  (.installed.pluginOrigin | type == "string") and
  (.installed.pluginCommit | type == "string") and
  (.installed.themeSourceId | type == "string") and
  (.installed.themeSourceUrl | type == "string") and
  (.installed.themeSourceCommit | type == "string") and
  (.installed.themeInstallMode == "source" or .installed.themeInstallMode == "plugin-link" or .installed.themeInstallMode == "copy") and
  .themeOwned == true and
  (
    if .installed.themeInstallMode == "source" then
      .pluginOwned == true and
      .installed.pluginOrigin == $repo and
      (.installed.pluginCommit | length > 0) and
      (.installed.themeSourceId | test("^[a-z0-9]+(-[a-z0-9]+)*-[a-f0-9]{12}$")) and
      .installed.themeSourceUrl == $repo and
      .installed.themeSourceCommit == .installed.pluginCommit
    elif .installed.themeInstallMode == "plugin-link" then
      .pluginOwned == true and
      .installed.pluginOrigin == $repo and
      (.installed.pluginCommit | length > 0) and
      .installed.themeSourceId == "" and
      .installed.themeSourceUrl == $repo and
      .installed.themeSourceCommit == .installed.pluginCommit
    else
      .installed.pluginOrigin == "" and .installed.pluginCommit == "" and
      .installed.themeSourceId == "" and .installed.themeSourceUrl == "" and .installed.themeSourceCommit == ""
    end
  ) and
  (.installed.fontTreeHash | type == "string") and
  (.installed.aboutHash | type == "string") and
  (.installed.screensaverHash | type == "string") and
  (.installed.commandHash | type == "string") and
  (.previous | type == "object") and
  (.previous.theme | type == "string") and
  (.previous.barPosition | type == "string") and
  (.previous.barTransparent | type == "boolean") and
  (.previous.aboutPresent | type == "boolean") and
  (.previous.screensaverPresent | type == "boolean")
' <<<"$state_json" >/dev/null || {
  echo "$PRODUCT_NAME install-state record is invalid; refusing to remove anything." >&2
  exit 1
}

PLUGIN_OWNED=$(jq -r '.pluginOwned' <<<"$state_json")
THEME_OWNED=$(jq -r '.themeOwned' <<<"$state_json")
FONT_OWNED=$(jq -r '.fontOwned' <<<"$state_json")
BRANDING_OWNED=$(jq -r '.brandingOwned' <<<"$state_json")
COMMAND_OWNED=$(jq -r '.commandOwned' <<<"$state_json")
FONT_TREE_HASH=$(jq -r '.installed.fontTreeHash' <<<"$state_json")
THEME_SOURCE_ID=$(jq -r '.installed.themeSourceId' <<<"$state_json")
THEME_SOURCE_URL=$(jq -r '.installed.themeSourceUrl' <<<"$state_json")
PLUGIN_ORIGIN=$(jq -r '.installed.pluginOrigin' <<<"$state_json")
PLUGIN_COMMIT=$(jq -r '.installed.pluginCommit' <<<"$state_json")
THEME_SOURCE_COMMIT=$(jq -r '.installed.themeSourceCommit' <<<"$state_json")
THEME_INSTALL_MODE=$(jq -r '.installed.themeInstallMode' <<<"$state_json")
ABOUT_HASH=$(jq -r '.installed.aboutHash' <<<"$state_json")
SCREENSAVER_HASH=$(jq -r '.installed.screensaverHash' <<<"$state_json")
COMMAND_HASH=$(jq -r '.installed.commandHash' <<<"$state_json")
PREVIOUS_THEME=$(jq -r '.previous.theme // ""' <<<"$state_json")
PREVIOUS_BAR_POSITION=$(jq -r '.previous.barPosition // "top"' <<<"$state_json")
PREVIOUS_BAR_TRANSPARENT=$(jq -r '.previous.barTransparent // false' <<<"$state_json")
PREVIOUS_ABOUT_PRESENT=$(jq -r '.previous.aboutPresent' <<<"$state_json")
PREVIOUS_SCREENSAVER_PRESENT=$(jq -r '.previous.screensaverPresent' <<<"$state_json")

hash_file() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

safe_copy_regular() {
  local source="$1" destination="$2" max_bytes="$3"
  python3 - "$source" "$destination" "$max_bytes" <<'PY'
import os
import signal
import stat
import sys

source, destination, raw_limit = sys.argv[1:]
limit = int(raw_limit)
def deadline(_signum, _frame):
    raise TimeoutError("bounded restore exceeded its 10-second deadline")
signal.signal(signal.SIGALRM, deadline)
signal.alarm(10)
flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
source_fd = os.open(source, flags)
try:
    source_stat = os.fstat(source_fd)
    if not stat.S_ISREG(source_stat.st_mode) or source_stat.st_size > limit:
        raise SystemExit(1)
    chunks = []
    total = 0
    while True:
        chunk = os.read(source_fd, min(65536, limit + 1 - total))
        if not chunk:
            break
        total += len(chunk)
        if total > limit:
            raise SystemExit(1)
        chunks.append(chunk)
finally:
    os.close(source_fd)

parent = os.path.dirname(destination)
name = os.path.basename(destination)
directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY
if hasattr(os, "O_NOFOLLOW"):
    directory_flags |= os.O_NOFOLLOW
parent_fd = os.open(parent, directory_flags)
temporary = f".{name}.one-bit-bureau-{os.getpid()}"
output_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    output_flags |= os.O_NOFOLLOW
try:
    output_fd = os.open(temporary, output_flags, 0o600, dir_fd=parent_fd)
    try:
        for chunk in chunks:
            view = memoryview(chunk)
            while view:
                written = os.write(output_fd, view)
                view = view[written:]
        os.fsync(output_fd)
    finally:
        os.close(output_fd)
    os.replace(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
finally:
    try:
        os.unlink(temporary, dir_fd=parent_fd)
    except FileNotFoundError:
        pass
    os.close(parent_fd)
PY
}

safe_hash_regular() {
  local source="$1" max_bytes="$2"
  python3 - "$source" "$max_bytes" <<'PY'
import hashlib
import os
import signal
import stat
import sys

source, raw_limit = sys.argv[1:]
limit = int(raw_limit)
def deadline(_signum, _frame):
    raise TimeoutError("bounded hash exceeded its 10-second deadline")
signal.signal(signal.SIGALRM, deadline)
signal.alarm(10)
flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(source, flags)
digest = hashlib.sha256()
total = 0
try:
    source_stat = os.fstat(fd)
    if not stat.S_ISREG(source_stat.st_mode) or source_stat.st_size > limit:
        raise SystemExit(1)
    while True:
        chunk = os.read(fd, min(65536, limit + 1 - total))
        if not chunk:
            break
        total += len(chunk)
        if total > limit:
            raise SystemExit(1)
        digest.update(chunk)
finally:
    os.close(fd)
print(digest.hexdigest())
PY
}

font_tree_hash() {
  local directory="$1"
  [[ -f $directory/DepartureMono-1.500.otf && -f $directory/MonaspaceKryptonNF-Regular-1.400.otf ]] || return 1
  [[ $(find "$directory" -maxdepth 1 -type f | wc -l | tr -d ' ') == 2 ]] || return 1
  {
    hash_file "$directory/DepartureMono-1.500.otf"
    hash_file "$directory/MonaspaceKryptonNF-Regular-1.400.otf"
  } | hash_file /dev/stdin
}

theme_source_commands_available() {
  local command
  [[ -n ${OMARCHY_PATH:-} ]] || return 1
  for command in inspect install update detach; do
    [[ -x $OMARCHY_PATH/bin/omarchy-theme-source-$command ]] || return 1
  done
}

preflight_owned_installation() {
  local actual_plugin_origin actual_plugin_commit source_path actual_source_url actual_source_commit expected_theme_path actual_theme_path

  if [[ $PLUGIN_OWNED == "true" ]]; then
    [[ -e $PLUGIN_TARGET && ! -L $PLUGIN_TARGET ]] || {
      echo "$PRODUCT_NAME plugin payload is missing or unsafe; no changes were made." >&2
      return 1
    }
    if [[ -n $PLUGIN_ORIGIN ]]; then
      [[ -d $PLUGIN_TARGET/.git ]] || {
        echo "$PRODUCT_NAME plugin checkout is not Git-managed; no changes were made." >&2
        return 1
      }
      actual_plugin_origin=$(git -C "$PLUGIN_TARGET" config --get remote.origin.url 2>/dev/null || true)
      [[ $actual_plugin_origin == "$PLUGIN_ORIGIN" && $PLUGIN_ORIGIN == "$EXPECTED_REPO_URL" ]] || {
        echo "$PRODUCT_NAME plugin origin no longer matches its ownership record; no changes were made." >&2
        return 1
      }
      [[ -z $(git -C "$PLUGIN_TARGET" status --porcelain) ]] || {
        echo "$PRODUCT_NAME plugin checkout has local changes; no changes were made." >&2
        return 1
      }
      actual_plugin_commit=$(git -C "$PLUGIN_TARGET" rev-parse HEAD 2>/dev/null || true)
      [[ $actual_plugin_commit == "$PLUGIN_COMMIT" ]] || {
        echo "$PRODUCT_NAME plugin commit no longer matches its ownership record; no changes were made." >&2
        return 1
      }
    else
      [[ $THEME_INSTALL_MODE == "copy" && ! -e $PLUGIN_TARGET/.git ]] || {
        echo "$PRODUCT_NAME local plugin payload no longer matches its ownership record; no changes were made." >&2
        return 1
      }
    fi
  fi

  [[ -e $THEME_TARGET || -L $THEME_TARGET ]] || {
    echo "$PRODUCT_NAME owned theme is missing; no changes were made." >&2
    return 1
  }
  if [[ $THEME_INSTALL_MODE == "source" ]]; then
    theme_source_commands_available || {
      echo "$PRODUCT_NAME requires Omarchy's complete theme-source API for safe removal; update Omarchy first." >&2
      return 1
    }
    source_path="$THEME_SOURCES_DIR/$THEME_SOURCE_ID"
    [[ -d $source_path/.git && ! -L $source_path ]] || {
      echo "$PRODUCT_NAME recorded theme source is missing or unsafe; no changes were made." >&2
      return 1
    }
    actual_source_url=$(git -C "$source_path" config --get remote.origin.url 2>/dev/null || true)
    [[ $actual_source_url == "$THEME_SOURCE_URL" && $THEME_SOURCE_URL == "$EXPECTED_REPO_URL" ]] || {
      echo "$PRODUCT_NAME recorded theme source origin changed; no changes were made." >&2
      return 1
    }
    [[ -z $(git -C "$source_path" status --porcelain) ]] || {
      echo "$PRODUCT_NAME recorded theme source has local changes; no changes were made." >&2
      return 1
    }
    actual_source_commit=$(git -C "$source_path" rev-parse HEAD 2>/dev/null || true)
    [[ $actual_source_commit == "$THEME_SOURCE_COMMIT" ]] || {
      echo "$PRODUCT_NAME recorded theme source commit changed; no changes were made." >&2
      return 1
    }
    expected_theme_path=$(realpath "$source_path/themes/$THEME_NAME" 2>/dev/null || true)
    [[ -L $THEME_TARGET ]] || {
      echo "$PRODUCT_NAME theme is not linked from its recorded source; no changes were made." >&2
      return 1
    }
  elif [[ $THEME_INSTALL_MODE == "plugin-link" ]]; then
    expected_theme_path=$(realpath "$PLUGIN_TARGET/themes/$THEME_NAME" 2>/dev/null || true)
    [[ -L $THEME_TARGET ]] || {
      echo "$PRODUCT_NAME theme is not linked from its plugin checkout; no changes were made." >&2
      return 1
    }
  else
    [[ -d $THEME_TARGET && ! -L $THEME_TARGET ]] || {
      echo "$PRODUCT_NAME copied theme is not an owned directory; no changes were made." >&2
      return 1
    }
    return 0
  fi

  actual_theme_path=$(realpath "$THEME_TARGET" 2>/dev/null || true)
  [[ -n $expected_theme_path && $actual_theme_path == "$expected_theme_path" ]] || {
    echo "$PRODUCT_NAME theme link no longer belongs to its recorded installation; no changes were made." >&2
    return 1
  }
}

preflight_owned_installation || exit 1

APP_CHROME_STATE="$STATE_DIR/app-chrome-state.json"
APP_CHROME_HELPER="$PLUGIN_TARGET/scripts/one-bit-bureau-app-chrome.py"
if [[ -f $APP_CHROME_HELPER && ! -L $APP_CHROME_HELPER ]]; then
  python3 "$APP_CHROME_HELPER" --plugin-dir "$PLUGIN_TARGET" off || {
    echo "$PRODUCT_NAME could not safely restore its GTK3 app-chrome preview; the plugin payload was retained." >&2
    exit 1
  }
elif [[ -e $APP_CHROME_STATE || -L $APP_CHROME_STATE ]]; then
  echo "$PRODUCT_NAME cannot remove an owned GTK3 app-chrome preview without its helper; the plugin payload was retained." >&2
  exit 1
fi

BRANDING_BACKUP_RETAINED=false
restore_branding_file() {
  local current="$1" backup="$2" previous_present="$3" installed_hash="$4"
  local current_hash=""
  if [[ -L $current || ( -e $current && ! -f $current ) ]]; then
    BRANDING_BACKUP_RETAINED=true
    return
  fi
  if [[ $previous_present == true && ( ! -f $backup || -L $backup ) ]]; then
    BRANDING_BACKUP_RETAINED=true
    return
  fi
  if [[ -f $current ]]; then
    current_hash=$(safe_hash_regular "$current" "$BRANDING_MAX_BYTES" 2>/dev/null || true)
  fi
  if [[ $current_hash == "$installed_hash" ]]; then
    if [[ $previous_present == true ]]; then
      safe_copy_regular "$backup" "$current" "$BRANDING_MAX_BYTES"
      rm -f -- "$backup"
    else
      rm -f -- "$current"
    fi
  elif [[ ! -e $current && ! -L $current && $previous_present == true && -f $backup ]]; then
    safe_copy_regular "$backup" "$current" "$BRANDING_MAX_BYTES"
    rm -f -- "$backup"
  elif [[ $previous_present == true && -f $backup ]]; then
    BRANDING_BACKUP_RETAINED=true
  fi
}

current_theme=""
if [[ -f $THEME_STATE ]]; then
  current_theme=$(<"$THEME_STATE")
fi
current_position=$(jq -r '.bar.position // "top"' "$SHELL_CONFIG" 2>/dev/null || echo top)
current_transparent=$(jq -r '.bar.transparent // false' "$SHELL_CONFIG" 2>/dev/null || echo false)

if [[ $current_theme == "$THEME_NAME" && -n $PREVIOUS_THEME ]]; then
  omarchy theme set "$PREVIOUS_THEME"
fi
if [[ $current_position == "top" && $PREVIOUS_BAR_POSITION != "top" ]]; then
  omarchy bar position "$PREVIOUS_BAR_POSITION"
fi
if [[ $current_transparent == "false" && $PREVIOUS_BAR_TRANSPARENT != "false" ]]; then
  omarchy bar transparent "$PREVIOUS_BAR_TRANSPARENT"
fi

if [[ $BRANDING_OWNED == "true" ]]; then
  if [[ -L $BRANDING_TARGET || ( -e $BRANDING_TARGET && ! -d $BRANDING_TARGET ) ]]; then
    BRANDING_BACKUP_RETAINED=true
  else
    restore_branding_file "$BRANDING_TARGET/about.txt" "$BRANDING_BACKUP_DIR/about.txt" "$PREVIOUS_ABOUT_PRESENT" "$ABOUT_HASH"
    restore_branding_file "$BRANDING_TARGET/screensaver.txt" "$BRANDING_BACKUP_DIR/screensaver.txt" "$PREVIOUS_SCREENSAVER_PRESENT" "$SCREENSAVER_HASH"
  fi
fi

if [[ $FONT_OWNED == "true" && -d $FONT_TARGET ]]; then
  current_font_hash=$(font_tree_hash "$FONT_TARGET" || true)
  if [[ -n $current_font_hash && $current_font_hash == "$FONT_TREE_HASH" ]]; then
    rm -rf -- "$FONT_TARGET"
    fc-cache -f >/dev/null
  else
    echo "$PRODUCT_NAME preserved modified files in $FONT_TARGET" >&2
  fi
fi

if [[ $THEME_OWNED == "true" ]]; then
  if [[ -e $THEME_TARGET || -L $THEME_TARGET ]]; then
    if [[ $THEME_INSTALL_MODE == "source" ]]; then
      source_path="$THEME_SOURCES_DIR/$THEME_SOURCE_ID"
      [[ -d $source_path/.git && ! -L $source_path ]] || {
        echo "$PRODUCT_NAME recorded theme source is missing or unsafe; refusing to detach it." >&2
        exit 1
      }
      actual_source_url=$(git -C "$source_path" config --get remote.origin.url 2>/dev/null || true)
      [[ $actual_source_url == "$THEME_SOURCE_URL" ]] || {
        echo "$PRODUCT_NAME recorded theme source URL does not match the installed source; refusing to detach it." >&2
        exit 1
      }
      [[ -L $THEME_TARGET ]] || {
        echo "$PRODUCT_NAME theme is not linked from its recorded source; refusing to detach it." >&2
        exit 1
      }
      expected_theme_path=$(realpath "$source_path/themes/$THEME_NAME" 2>/dev/null || true)
      actual_theme_path=$(realpath "$THEME_TARGET" 2>/dev/null || true)
      [[ -n $expected_theme_path && $actual_theme_path == "$expected_theme_path" ]] || {
        echo "$PRODUCT_NAME theme link is not owned by its recorded source; refusing to detach it." >&2
        exit 1
      }
      omarchy theme source detach "$THEME_SOURCE_ID" "$THEME_NAME" --json >/dev/null
    elif [[ $THEME_INSTALL_MODE == "plugin-link" ]]; then
      [[ -L $THEME_TARGET ]] || {
        echo "$PRODUCT_NAME theme is not linked from its plugin checkout; refusing to remove it." >&2
        exit 1
      }
      expected_theme_path=$(realpath "$PLUGIN_TARGET/themes/$THEME_NAME" 2>/dev/null || true)
      actual_theme_path=$(realpath "$THEME_TARGET" 2>/dev/null || true)
      [[ -n $expected_theme_path && $actual_theme_path == "$expected_theme_path" ]] || {
        echo "$PRODUCT_NAME theme link is not owned by its plugin checkout; refusing to remove it." >&2
        exit 1
      }
      rm -- "$THEME_TARGET"
    else
      [[ -d $THEME_TARGET && ! -L $THEME_TARGET ]] || {
        echo "$PRODUCT_NAME copied theme is not an owned directory; refusing to remove it." >&2
        exit 1
      }
      omarchy theme remove "$THEME_NAME"
    fi
  fi
  [[ ! -e $THEME_TARGET && ! -L $THEME_TARGET ]] || {
    echo "$PRODUCT_NAME could not remove its theme; the ownership record was retained." >&2
    exit 1
  }
fi

if [[ $PLUGIN_OWNED == "true" ]]; then
  omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  if [[ -e $PLUGIN_TARGET || -L $PLUGIN_TARGET ]]; then
    omarchy plugin remove "$PLUGIN_ID" --yes
  fi
  [[ ! -e $PLUGIN_TARGET && ! -L $PLUGIN_TARGET ]] || {
    echo "$PRODUCT_NAME could not remove its plugin payload; the ownership record was retained." >&2
    exit 1
  }
fi

if [[ $COMMAND_OWNED == "true" && -n $COMMAND_HASH ]]; then
  command_result=$(python3 "$SECURE_IO" command remove-if-owned --expected-hash "$COMMAND_HASH") || {
    echo "$PRODUCT_NAME could not safely inspect its installed command; the ownership record was retained." >&2
    exit 1
  }
  if [[ $command_result == "preserved" ]]; then
    echo "$PRODUCT_NAME preserved modified command at $COMMAND_TARGET" >&2
  fi
fi

state_delete_result=$(python3 "$SECURE_IO" install-state delete --expected-hash "$state_record_hash") || {
  echo "$PRODUCT_NAME could not safely remove its ownership record." >&2
  exit 1
}
[[ $state_delete_result == "removed" ]] || {
  echo "$PRODUCT_NAME ownership record changed during removal and was preserved." >&2
  exit 1
}
rmdir "$BRANDING_BACKUP_DIR" 2>/dev/null || true
rmdir "$STATE_DIR/backups" 2>/dev/null || true
rmdir "$STATE_DIR" 2>/dev/null || true

echo
echo "$PRODUCT_NAME was removed and the settings it still owned were restored."
echo "User data was retained:"
echo "  your configured Desktop directory"
echo "  $HOME/.config/omarchy/one-bit-bureau/dock-pinned.json"
echo "  $HOME/.config/omarchy/one-bit-bureau/dock-settings.json"
echo "  $HOME/.config/omarchy/one-bit-bureau/desktop-icon-positions.json"
echo "  $HOME/.config/omarchy/one-bit-bureau/dock-icons.json"
echo "  $HOME/.config/omarchy/one-bit-bureau/icons"
if [[ $BRANDING_BACKUP_RETAINED == true ]]; then
  echo "  previous branding backup retained at $BRANDING_BACKUP_DIR"
fi
